#!/usr/bin/env bash
# Print a revision for structural policy files. Runtime budget-policy.conf is intentionally not
# included: usage/reset movement and threshold tuning apply at the next dispatch without restart.
# Roster-generation changes are included because Claude caches agent definitions.
set -euo pipefail

legacy=0
if [[ "${1:-}" == "--legacy" ]]; then
  legacy=1
  shift
fi
root="${1:-}"
[[ -n "$root" ]] || { echo "usage: orch-policy-rev [--legacy] <repo-root>" >&2; exit 2; }

files=(
  "$root/model-policy.conf"
  "$root/templates/lead.md.tpl"
  "$root/templates/dev.md.tpl"
  "$root/agents/orchestrator.md"
  "$root/agents/verifier.md"
  "$root/agents/verifier-normal.md"
  "$root/build-roster.sh"
  "$root/build-roster-runtime.sh"
)

if [[ $legacy -eq 1 ]]; then
  sha256sum "${files[@]}" | sha256sum | awk '{print $1}'
else
  sha256sum "${files[@]}" | awk '{print $1}' | sha256sum | awk '{print $1}'
fi
