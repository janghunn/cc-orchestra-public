#!/usr/bin/env python3
"""Check npm's latest stable CLI releases before an orchestra model invocation."""
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

PACKAGES = {"claude": "@anthropic-ai/claude-code", "codex": "@openai/codex"}


def run(*args, timeout=45):
    return subprocess.check_output(args, text=True, timeout=timeout).strip()


def main(names):
    if not names or any(name not in PACKAGES for name in names):
        raise ValueError("usage: orch-cli-update claude|codex [claude|codex]")
    if os.environ.get("CC_ORCH_CLI_AUTO_UPDATE", "1") == "0":
        return
    npm = shutil.which("npm")
    if not npm:
        raise ValueError("npm is required for automatic CLI updates")
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "cc-orchestra"
    state.mkdir(parents=True, exist_ok=True)
    # Both packages share npm's global prefix. Serialize updates across all sessions/lanes.
    with (state / "cli-update.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        root = Path(run(npm, "root", "-g")).resolve()
        for name in dict.fromkeys(names):
            package = PACKAGES[name]
            binary = shutil.which(os.environ.get("CODEX_BIN", "codex") if name == "codex" else name)
            if not binary or not Path(binary).resolve().is_relative_to(root / package):
                raise ValueError(f"{name} on PATH is not managed by this npm prefix ({root}); refusing to update a different installation")
            latest = json.loads(run(npm, "view", package + "@latest", "version", "--json",
                                    "--prefer-online", "--fetch-retries=0", "--fetch-timeout=20000"))
            if not isinstance(latest, str) or not re.fullmatch(r"\d+\.\d+\.\d+", latest):
                raise ValueError(f"invalid stable release for {name}: {latest!r}")
            def version():
                match = re.search(r"\b\d+\.\d+\.\d+(?:-[\w.-]+)?", run(binary, "--version"))
                if not match:
                    raise ValueError(f"cannot determine {name} version")
                return match.group()
            try:
                installed = version()
            except (ValueError, OSError, subprocess.SubprocessError):
                # Repair an interrupted npm installation instead of treating it as current.
                installed = "unavailable"
            if installed != latest:
                print(f"cc-orch: updating {name} {installed} -> {latest}", file=sys.stderr, flush=True)
                subprocess.run([npm, "install", "-g", package + "@" + latest,
                                "--no-audit", "--no-fund", "--fetch-retries=0",
                                "--fetch-timeout=20000"], check=True, timeout=1800,
                               stdout=sys.stderr)
                if version() != latest:
                    raise ValueError(f"{name} still resolves to a different version after update")
            print(f"cc-orch: {name} {latest} (latest verified)", file=sys.stderr)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print(f"cc-orch: CLI update check failed; launch stopped: {error}", file=sys.stderr)
        sys.exit(1)
