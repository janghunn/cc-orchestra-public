#!/usr/bin/env bash
# codex-run — cc-orchestra's single entry point to the Codex CLI.
#
# Codex owns the token-heavy paths; intake is dispatched by Tier 1 and the rest by Tier 2:
#   Tier 3 lane   implement / resume  — healthy gpt-6-astra (gpt-6-sol fallback when the account
#                 lacks it; or gpt-6-luna for mechanical bulk) writes code;
#                 implement is the DEFAULT lane for every unit (dev-* is the exception), and
#                 --lane <name> allows a second concurrent unit per task
#   Phase A aid   investigate — read-only root-cause / codebase analysis, so long evidence
#                 hunts spend Codex quota instead of the lead's Claude 5h session bucket
#   Tier 1 aid    intake — read-only scope/test map before a brief is finalized
#   Tier 4 gate   verify / review / plan-review — executable verification and adversarial review
#
# Why a wrapper instead of raw `codex exec` in agent prompts:
#   - A model's catalog DEFAULT reasoning effort is often lower than the lane intends
#     (gpt-5.6-sol: "low"; GPT-6 models: "medium", measured from models_cache.json), so a forgotten
#     -c model_reasoning_effort produces a shallow run. This wrapper passes an explicit policy effort.
#   - Sandbox mode, timeouts, artifact paths and thread-id capture stay uniform across leads,
#     which is what keeps the .orchestra artifacts comparable between tasks.
#   - CC_ORCH_CODEX_ROUTE (set by codex-run-runtime only on auto-routed calls) enables the Astra
#     availability fallback only when the marker names the resolved model, without overriding an
#     explicit model choice. Resume never falls back: it continues the recorded thread model; pass
#     --model sol to move a thread.
#   - Failure classes get distinct exit codes lead prompts can react to deterministically.
#   - Codex-only mode explicitly skips execution approvals and CLI sandboxing at the user's
#     request; hybrid lanes retain their per-mode sandbox policy.
#
# Flag order matters and is easy to get wrong by hand (measured on codex-cli 0.144.4):
# exec-level flags must come BEFORE the `resume` subcommand —
#   codex exec [flags] resume <thread-id> <prompt>     # works
#   codex exec resume <thread-id> [flags] <prompt>     # "unexpected argument '--sandbox'"
#
# usage:
#   codex-run implement   <workdir> <task-dir> [--mech|--escalate] [--fast-mode] [--lane L] [--model M] [--effort E]
#   codex-run intake      <workdir> <task-dir> "<goal>" [--fast|--fast-mode] [--model M] [--effort E]
#   codex-run investigate <workdir> <task-dir> "<question>" [--fast|--fast-mode] [--model M] [--effort E]
#   codex-run resume      <workdir> <task-dir> "<follow-up message>" [--escalate] [--fast-mode] [--lane L]
#   codex-run review      <workdir> <task-dir> [--base <branch>] [--fast|--fast-mode] [--model M] [--effort E]
#   codex-run plan-review <workdir> <task-dir> [--fast|--fast-mode] [--model M] [--effort E]
#   codex-run verify      <workdir> <task-dir> [--critical] [--fast-mode] [--model M] [--effort E]
#   codex-run status      <task-dir>
#   (all model-calling modes also accept --dry-run: print the assembled command, run nothing)
#
#   <workdir>   the checkout the code lives in (the lead's worktree in worktree mode)
#   <task-dir>  the .orchestra/<NN>-<slug>/ artifact directory
#   --lane      names a second implement thread so two units can run concurrently in one task
#               (own artifact, own event log, own thread id; default lane is "implement")
#
# artifacts written into <task-dir>:
#   implement/resume -> impl-report-codex[-<lane>].md    review -> codex-review.md
#   plan-review      -> plan-review-codex.md             investigate -> codex-investigation.md
#   intake           -> codex-intake.md                  verify -> codex-verdict.md
#   all              -> codex-<mode>[-<lane>].jsonl, .stderr.log
#   .codex-session   -> "<lane>=<thread-id>" lines; resume reads these to continue a thread
#
# exit codes: 0 ok · 1 codex failed · 2 usage/setup · 3 quota/rate-limit · 4 auth · 5 timeout · 6 model unavailable
set -uo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE_DIR="${CC_ORCH_STATE_DIR:-$HOME/.claude/orchestra-state}"
if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
  STATE_DIR="${CC_ORCH_STATE_DIR:-$HOME/.local/state/cc-orchestra-codex}"
fi
GLOBAL_LOG="$STATE_DIR/codex.log"

# shellcheck source=/dev/null
. "$REPO_DIR/model-policy.conf"
# shellcheck source=/dev/null
. "$REPO_DIR/lib/codex-catalog.sh"

if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
  policy_values="$(python3 "$REPO_DIR/lib/orch_codex.py" shell-policy)" || exit 2
  while IFS='=' read -r policy_key policy_value; do
    printf -v "$policy_key" '%s' "$policy_value"
  done <<< "$policy_values"
fi

usage() {
  cat >&2 <<'EOF'
usage:
  codex-run implement   <workdir> <task-dir> [--mech|--escalate] [--fast-mode] [--lane L] [--model M] [--effort E]
  codex-run intake      <workdir> <task-dir> "<goal>" [--fast|--fast-mode] [--model M] [--effort E]
  codex-run investigate <workdir> <task-dir> "<question>" [--fast|--fast-mode] [--model M] [--effort E]
  codex-run resume      <workdir> <task-dir> "<follow-up message>" [--escalate] [--fast-mode] [--lane L]
  codex-run review      <workdir> <task-dir> [--base <branch>] [--fast|--fast-mode] [--model M] [--effort E]
  codex-run plan-review <workdir> <task-dir> [--fast|--fast-mode] [--model M] [--effort E]
  codex-run verify      <workdir> <task-dir> [--critical] [--fast-mode] [--model M] [--effort E]
  codex-run status      <task-dir>
  (model-calling modes also accept --dry-run: print the assembled command, run nothing)

  <workdir>   the checkout the code lives in (the lead's worktree in worktree mode)
  <task-dir>  the .orchestra/<NN>-<slug>/ artifact directory
  --lane L    second concurrent implement thread in the same task (own artifact + thread)
  --critical  raise a review or verify run to the critical effort policy
  --fast      switch to the lower-cost Luna model/effort policy (legacy compatibility)
  --fast-mode keep the resolved Astra/Sol/Terra model and opt this invocation into official Fast mode
  models: sol=gpt-6-sol  luna=gpt-6-luna  terra=gpt-5.6-terra  astra=gpt-6-astra (or any full slug)
  exit: 0 ok · 1 codex failed · 2 usage/setup · 3 quota · 4 auth · 5 timeout · 6 model unavailable
EOF
  exit 2
}
die() { echo "codex-run: $*" >&2; exit 2; }

# --- model shortcuts ---------------------------------------------------------------------
slug() { # sol|luna|terra|astra|<full slug> -> full slug
  case "$1" in
    sol)   echo "gpt-6-sol" ;;
    luna)  echo "gpt-6-luna" ;;
    terra) echo "gpt-5.6-terra" ;;
    astra) echo "gpt-6-astra" ;;
    *)     echo "$1" ;;
  esac
}

# --- args --------------------------------------------------------------------------------
MODE="${1:-}"; shift || true
[ -n "$MODE" ] || usage

if [ "$MODE" = "status" ]; then
  TASK_DIR="${1:-}"; [ -d "${TASK_DIR:-/nonexistent}" ] || die "status needs an existing <task-dir>"
  echo "threads (.codex-session):"
  sed 's/^/  /' "$TASK_DIR/.codex-session" 2>/dev/null || echo "  (none)"
  echo "artifacts:"
  ls -la "$TASK_DIR"/impl-report-codex*.md "$TASK_DIR"/codex-review.md \
         "$TASK_DIR"/plan-review-codex.md "$TASK_DIR"/codex-investigation.md \
         "$TASK_DIR"/codex-intake.md "$TASK_DIR"/codex-verdict.md \
         2>/dev/null | sed 's/^/  /' || echo "  (none)"
  echo "recent runs (global):"
  tail -5 "$GLOBAL_LOG" 2>/dev/null | sed 's/^/  /' || echo "  (none)"
  exit 0
fi

WORKDIR="${1:-}"; TASK_DIR="${2:-}"; shift 2 || usage
[ -d "${WORKDIR:-/nonexistent}" ]  || die "workdir '$WORKDIR' does not exist"
[ -d "${TASK_DIR:-/nonexistent}" ] || die "task-dir '$TASK_DIR' does not exist"
WORKDIR="$(cd "$WORKDIR" && pwd)"; TASK_DIR="$(cd "$TASK_DIR" && pwd)"

# The message argument is positional and comes before the flags; a leading "--" means the
# caller forgot it and a flag would silently become the prompt (and --dry-run would run live).
FOLLOWUP=""
if [ "$MODE" = "resume" ]; then
  FOLLOWUP="${1:-}"; shift || true
  case "$FOLLOWUP" in ""|--*) die 'resume needs a follow-up message: codex-run resume <workdir> <task-dir> "<message>" [flags]' ;; esac
fi
QUESTION=""
if [ "$MODE" = "investigate" ]; then
  QUESTION="${1:-}"; shift || true
  case "$QUESTION" in ""|--*) die 'investigate needs a question: codex-run investigate <workdir> <task-dir> "<question>" [flags]' ;; esac
fi
GOAL=""
if [ "$MODE" = "intake" ]; then
  GOAL="${1:-}"; shift || true
  case "$GOAL" in ""|--*) die 'intake needs a goal: codex-run intake <workdir> <task-dir> "<goal>" [flags]' ;; esac
fi

MODEL="" EFFORT="" BASE="" LANE="implement" DRY=0 CRITICAL=0 FAST=0 FAST_MODE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --mech)     MODEL="$CODEX_MECH_MODEL";  EFFORT="$CODEX_MECH_EFFORT" ;;
    --fast)     MODEL="$CODEX_FAST_MODEL";  EFFORT="$CODEX_FAST_EFFORT"; FAST=1 ;;
    --fast-mode) FAST_MODE=1 ;;
    --escalate) EFFORT="$CODEX_ESCALATE_EFFORT" ;;
    --critical) CRITICAL=1 ;;
    --model)    shift; MODEL="$(slug "${1:-}")" ;;
    --effort)   shift; EFFORT="${1:-}" ;;
    --base)     shift; BASE="${1:-}" ;;
    --lane)     shift; LANE="${1:-}" ;;
    --dry-run)  DRY=1 ;;
    *) die "unknown option '$1'" ;;
  esac
  shift || true
done

[ "$FAST_MODE" = "0" ] || [ "$FAST" = "0" ] || die "--fast (Luna) and --fast-mode (Astra/Sol/Terra Fast tier) cannot be combined"

if [ "$CRITICAL" = "1" ]; then
  case "$MODE" in review|plan-review|verify) ;; *) die "--critical is only valid for review, plan-review, or verify" ;; esac
  [ "$FAST" = "0" ] || die "--fast and --critical cannot be combined"
fi

SESSION_FILE="$TASK_DIR/.codex-session"

# Lane names key .codex-session entries and suffix artifacts — keep them shell- and path-safe,
# and stop an implement lane from hijacking the read-only lanes' keys/artifacts.
if [ "$LANE" != "implement" ]; then
  printf '%s' "$LANE" | grep -qE '^[a-z0-9][a-z0-9_-]{0,31}$' || die "invalid lane name '$LANE'"
  if [ "$MODE" = "implement" ]; then
    case "$LANE" in review|plan-review|investigate|intake|verify) die "lane '$LANE' is reserved" ;; esac
  fi
fi

case "$MODE" in
  implement)            MODEL="${MODEL:-$CODEX_IMPL_MODEL}"   EFFORT="${EFFORT:-$CODEX_IMPL_EFFORT}"
                        TIMEOUT="${CODEX_IMPL_TIMEOUT_SECS}" ;;
  investigate)          MODEL="${MODEL:-$CODEX_INVESTIGATE_MODEL}" EFFORT="${EFFORT:-$CODEX_INVESTIGATE_EFFORT}"
                        TIMEOUT="${CODEX_REVIEW_TIMEOUT_SECS}" ;;
  intake)               MODEL="${MODEL:-$CODEX_INTAKE_MODEL}" EFFORT="${EFFORT:-$CODEX_INTAKE_EFFORT}"
                        TIMEOUT="${CODEX_REVIEW_TIMEOUT_SECS}" ;;
  resume)
    # A follow-up continues the lane it resumes: same thread, and by default the same
    # model/effort that lane last ran with (a --mech run must not silently escalate to sol).
    # --escalate / --model / --effort still override.
    REC="$(sed -n "s/^$LANE=//p" "$SESSION_FILE" 2>/dev/null | head -1)"
    TID="${REC%%|*}"
    [ -n "$TID" ] || die "no recorded $LANE thread in $SESSION_FILE — run '$LANE' first"
    REC_MODEL="$(printf '%s' "$REC" | cut -s -d'|' -f2)"
    REC_EFFORT="$(printf '%s' "$REC" | cut -s -d'|' -f3)"
    MODEL="${MODEL:-${REC_MODEL:-$CODEX_IMPL_MODEL}}"
    EFFORT="${EFFORT:-${REC_EFFORT:-$CODEX_IMPL_EFFORT}}"
    TIMEOUT="${CODEX_IMPL_TIMEOUT_SECS}" ;;
  review|plan-review)   MODEL="${MODEL:-$CODEX_REVIEW_MODEL}" EFFORT="${EFFORT:-$CODEX_REVIEW_EFFORT}"
                        TIMEOUT="${CODEX_REVIEW_TIMEOUT_SECS}" ;;
  verify)               MODEL="${MODEL:-$CODEX_VERIFY_MODEL}" EFFORT="${EFFORT:-$CODEX_VERIFY_EFFORT}"
                        TIMEOUT="${CODEX_IMPL_TIMEOUT_SECS}" ;;
  *) usage ;;
esac

if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
  [ "$MODEL" = gpt-6-astra ] || die 'Codex-only mode requires gpt-6-astra; no model fallback (use --model astra when adopting an older thread)'
  unset CC_ORCH_CODEX_ROUTE
fi
case "${CC_ORCH_CODEX_ROUTE:-}" in
  *":$MODEL@"*) AUTO_ROUTED=1 ;;
  *) AUTO_ROUTED=0 ;;
esac

[ "$CRITICAL" = "1" ] && EFFORT="$CODEX_CRITICAL_EFFORT"

# gpt-6-sol (sol alias, plain default) and gpt-5.6-sol are Sol-tier for Fast mode and ultra.
# Luna of both generations is excluded: the 2026-09-29 catalog caps it at max, and Fast mode
# is an Astra/Sol/Terra knob.
if [ "$FAST_MODE" = "1" ]; then
  case "$MODEL" in
    gpt-5.6-sol|gpt-6-sol|gpt-5.6-terra|gpt-6-astra) ;;
    *) die "--fast-mode keeps an Astra/Sol/Terra model; resolved model is '$MODEL'" ;;
  esac
fi

case "$EFFORT" in low|medium|high|xhigh|max|ultra) ;; *) die "invalid effort '$EFFORT'" ;; esac
# luna tops out at max; and "ultra" auto-delegates inside Codex — Tier 2 owns decomposition,
# so ultra never happens implicitly (a lead must type --effort ultra on explicit user request).
if [ "$EFFORT" = "ultra" ] && [ "$MODEL" != "gpt-5.6-sol" ] && [ "$MODEL" != "gpt-6-sol" ] && [ "$MODEL" != "gpt-5.6-terra" ] && [ "$MODEL" != "gpt-6-astra" ]; then
  die "effort 'ultra' is only supported by sol/terra/astra (got $MODEL)"
fi

command -v codex >/dev/null 2>&1 || { echo "codex-run: codex CLI not on PATH" >&2; exit 4; }

# --- Astra catalog gate --------------------------------------------------------------------
# gpt-6-astra is the healthy-tier default but is not on every account/CLI. The live/cached Codex
# catalog decides; other models keep the open-ended contract (Codex itself rejects unknown slugs).
# unknown = fail open; the run's own error is classified below and retried once when auto-routed.
FALLBACK_NOTE=""
astra_fallback_target() { # -> "model|effort" for an auto-routed mode, empty otherwise
  [ "$AUTO_ROUTED" = 1 ] || return 0
  case "$MODE" in
    implement)          printf '%s|%s\n' "$CODEX_IMPL_MODEL" "$CODEX_IMPL_EFFORT" ;;
    investigate)        printf '%s|%s\n' "$CODEX_INVESTIGATE_MODEL" "$CODEX_INVESTIGATE_EFFORT" ;;
    intake)             printf '%s|%s\n' "$CODEX_INTAKE_MODEL" "$CODEX_INTAKE_EFFORT" ;;
    review|plan-review) printf '%s|%s\n' "$CODEX_REVIEW_MODEL" "$CODEX_REVIEW_EFFORT" ;;
    verify)             printf '%s|%s\n' "$CODEX_VERIFY_MODEL" "$CODEX_VERIFY_EFFORT" ;;
  esac
}
use_astra_fallback() { # $1 reason; returns 1 when no fallback applies
  local target
  target="$(astra_fallback_target)"
  [ -n "$target" ] && [ "${target%%|*}" != "$MODEL" ] || return 1
  echo "CODEX-RUN: MODEL_FALLBACK — $MODEL $1; running $MODE on ${target%%|*}@${target#*|} instead" >&2
  FALLBACK_NOTE="fallback-from:$MODEL"
  MODEL="${target%%|*}"
  EFFORT="${target#*|}"
}
if [ "$MODEL" = "gpt-6-astra" ]; then
  probe="$(codex_catalog_probe "$MODEL")"
  cat_state="$(printf '%s\n' "$probe" | sed -n 's/^state=//p')"
  cat_efforts="$(printf '%s\n' "$probe" | sed -n 's/^efforts=//p')"
  cat_fast="$(printf '%s\n' "$probe" | sed -n 's/^fast=//p')"
  REASON=""
  case "$cat_state" in
    absent) REASON="is not in the Codex model catalog on this account/CLI" ;;
    present)
      case ",$cat_efforts," in *",$EFFORT,"*) ;; *) REASON="does not support effort '$EFFORT' per the Codex catalog" ;; esac
      [ -n "$REASON" ] || [ "$FAST_MODE" = 0 ] || [ "$cat_fast" = 1 ] || REASON="does not support the official Fast tier per the Codex catalog (CC_ORCH_ALWAYS_FAST_MODE=0 disables the default)"
      ;;
  esac
  if [ -n "$REASON" ] && ! use_astra_fallback "$REASON"; then
    if [ "$cat_state" = absent ]; then
      if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
        echo "CODEX-RUN: MODEL_UNAVAILABLE — Astra unavailable; no model/provider fallback. Preserve artifacts and report BLOCKED." >&2
      else
        echo "CODEX-RUN: MODEL_UNAVAILABLE — $MODEL $REASON (catalog: $(codex_catalog_file); refresh with 'codex debug models'; pass --model sol|terra to run elsewhere)" >&2
      fi
      exit 6
    fi
    die "$MODEL $REASON"
  fi
fi

# --- per-mode prompt and artifact --------------------------------------------------------
SPEC="$TASK_DIR/plan.md"; BRIEF="$TASK_DIR/brief.md"

case "$MODE" in
  implement)
    [ -r "$SPEC" ] || die "no spec at $SPEC — implement runs off plan.md"
    ARTIFACT="$TASK_DIR/impl-report-codex.md"
    SCOPE_LINE="Read first, in this order: $SPEC (the spec — its Changes list is your exact scope) and
$BRIEF (goal and scope boundary)."
    if [ "$LANE" != "implement" ]; then
      ARTIFACT="$TASK_DIR/impl-report-codex-$LANE.md"
      SCOPE_LINE="Read first, in this order: $SPEC (the spec) and $BRIEF (goal and scope boundary).
You are lane '$LANE' of several concurrent implementation lanes. The spec's *Lane assignment*
section maps lanes to work units — your scope is EXACTLY the unit assigned to '$LANE', nothing
else. If the spec has no such section or does not mention '$LANE', do not guess: report the
conflict under DEVIATIONS and stop."
    fi
    PROMPT="You are the Codex implementation lane (Tier 3) of a multi-agent delivery system. A task
lead wrote the spec; you write the code. Your final message is saved verbatim as the lead's
implementation-report artifact, so its format below is mandatory.

$SCOPE_LINE
All code edits happen in this checkout: $WORKDIR

Rules:
- Implement exactly the spec's *Changes* list. Files under *Do not touch* are off limits.
- Never run a git command that writes (commit, push, branch, switch, restore, stash) — the
  task lead owns all commits. Leave your changes in the working tree.
- Run the spec's *Verification* command(s) yourself. If one fails because of your change, fix it
  within the spec's scope and rerun the affected commands before reporting; report the real
  output of the final run. If a command cannot run, say so; never fabricate output.
- If the spec is contradictory or impossible on some point, implement what is unambiguous and
  report the conflict under DEVIATIONS; do not silently choose.

Final message — exactly this shape:
[codex] IMPLEMENTATION REPORT
SPEC: $SPEC
CHANGED: <file — what/why, one line per file>
COMMANDS: <each verification command + its key verbatim output lines>
RESULT: <pass|fail per command>
DEVIATIONS: <spec points not followed exactly, and why — or \"none\">
CONCERNS: <risks the lead should re-check in review — or \"none\">" ;;

  resume)
    case "$LANE" in
      review)      ARTIFACT="$TASK_DIR/codex-review.md" ;;
      plan-review) ARTIFACT="$TASK_DIR/plan-review-codex.md" ;;
      investigate) ARTIFACT="$TASK_DIR/codex-investigation.md" ;;
      intake)      ARTIFACT="$TASK_DIR/codex-intake.md" ;;
      verify)      ARTIFACT="$TASK_DIR/codex-verdict.md" ;;
      implement)   ARTIFACT="$TASK_DIR/impl-report-codex.md" ;;
      *)           ARTIFACT="$TASK_DIR/impl-report-codex-$LANE.md" ;;
    esac
    PROMPT="Follow-up from the task lead: $FOLLOWUP

After acting on it, end with a full updated report in the same mandatory format as your
previous final message (updated to the current state of the tree, not a delta)." ;;

  intake)
    ARTIFACT="$TASK_DIR/codex-intake.md"
    PROMPT="You are the read-only intake analyst for a multi-provider delivery system. The
orchestrator has a user goal but must not spend its control-model context crawling the repo.

User goal: $GOAL
Repo (read-only): $WORKDIR

Map evidence; do not design the solution. Find the likely owning files and symbols, existing
tests and exact runnable verification commands, scope boundaries, compatibility constraints,
and ambiguity that would materially change implementation. Cite file:line for every code claim.
Do not edit files, run a mutating command, or invent an acceptance criterion whose observation
you cannot name.

Final message — exactly this shape:
[codex] INTAKE
GOAL: <one-line restatement>
OWNERS: <file:line and symbol candidates, one per line>
VERIFICATION: <existing exact commands, or 'lead determines' with why>
BOUNDARIES: <in-scope/out-of-scope evidence and likely collisions>
RISKS: <low|normal|critical candidates with evidence>
AMBIGUITIES: <only choices that require user/orchestrator judgment, or 'none'>" ;;

  investigate)
    ARTIFACT="$TASK_DIR/codex-investigation.md"
    PROMPT="You are the read-only investigation lane of a multi-agent delivery system. A task lead
needs an evidence-grounded answer before designing; your final message is saved verbatim as
the lead's investigation artifact, so its format below is mandatory.

Question from the lead: $QUESTION

Repo (read-only): $WORKDIR
Context, where they exist: $BRIEF (the goal), $SPEC (the plan draft so far).

Rules:
- Evidence over hypothesis: cite file:line for every claim, and read the surrounding code
  rather than pattern-matching. Read-only commands (rg, git log/diff/show, ls) are yours.
- You are sandboxed read-only. If settling the question needs a write (running a build/test,
  adding a probe), do not attempt it — propose it under NEXT instead.
- If no single cause survives, rank the remaining hypotheses and give the one discriminating
  check for each.

Final message — exactly this shape:
[codex] INVESTIGATION
QUESTION: <restated in one line>
ANSWER: <the finding — or 'inconclusive'>
EVIDENCE: <file:line — what it shows, one per line>
NEXT: <discriminating checks or a fix direction for the lead — or 'none'>" ;;

  verify)
    [ -r "$SPEC" ] || die "no spec at $SPEC — verify runs off plan.md"
    ARTIFACT="$TASK_DIR/codex-verdict.md"
    PROMPT="You are the zero-context executable verifier (Tier 4) of a multi-provider delivery
system. You did not write the code and you must not read author opinions. Determine what is true.

Repo: $WORKDIR
Contract: $SPEC and $BRIEF
Forbidden inputs: review.md, codex-review.md, impl-report-*.md, summary.md, any old verdict.

Rules:
- Record git HEAD/status/diff before testing. Do not edit product code or configuration.
- Extract the exact Verification commands and run them. Test-created caches/output are allowed;
  product edits are not. Compare git status after testing and report newly created paths.
- Grade every numbered Acceptance criterion separately using command output or file:line evidence.
- A missing/unrunnable command or uncheckable criterion is INCONCLUSIVE, never PASS.
- Probe one cheap boundary/error path when the change introduces one. Report scope violations.

Final message — exactly this shape:
CODEX-VERDICT: PASS | FAIL | INCONCLUSIVE
HEAD: <sha>  DIRTY-BEFORE: <yes/no>  DIRTY-AFTER: <yes/no>
COMMANDS: <exact command and decisive verbatim output, one per line>
CRITERIA: <n met>/<n total; list failures/uncheckable>
SCOPE: <violations or 'none'>
CONCERNS: <non-failing concerns or 'none'>" ;;

  review)
    [ -r "$SPEC" ] || die "no spec at $SPEC — the review gate compares the diff against plan.md"
    ARTIFACT="$TASK_DIR/codex-review.md"
    if [ -z "$BASE" ]; then
      for b in main master; do
        git -C "$WORKDIR" rev-parse --verify -q "$b" >/dev/null 2>&1 && { BASE="$b"; break; }
      done
      [ -n "$BASE" ] || die "cannot infer a base branch — pass --base <branch>"
    fi
    PROMPT="You are the cross-family review gate (Tier 4) of a multi-agent delivery system. The diff
under review was written and already reviewed by Claude-family agents; your entire value is
finding what that family systematically missed. Be adversarial — hunt for reasons this change
is wrong; do not summarize or praise it.

Repo (read-only): $WORKDIR
Diff under review: \`git diff $BASE...HEAD\` plus anything uncommitted (\`git status --short\`).
Contract it must satisfy: $SPEC (spec; Acceptance + Changes + Do-not-touch) and $BRIEF (brief).

Check in priority order: real bugs (logic, edge cases, error paths, concurrency, resource
leaks), spec violations (unmet acceptance criteria, files changed outside the Changes list,
Do-not-touch violations), regressions to existing callers, test honesty (would the new tests
pass against the UNMODIFIED code?), security. Style nits only if they hide a defect.

Verify every finding against the actual code — read the surrounding context; no pattern-matching.

Final message — first line exactly one of:
CODEX-REVIEW: CLEAR
CODEX-REVIEW: BLOCKING <n> / NONBLOCKING <m>
then one line per finding:
- [BLOCKING|NONBLOCKING] <file>:<line> — <claim> — <failure scenario: inputs/state -> wrong outcome>" ;;

  plan-review)
    [ -r "$SPEC" ] || die "no spec at $SPEC"
    ARTIFACT="$TASK_DIR/plan-review-codex.md"
    PROMPT="You are a design cross-checker (pre-implementation gate) in a multi-agent delivery system.
A task lead wrote an implementation spec; nothing has been implemented yet. Your value is
attacking the design with non-Claude priors before code exists.

Read: $SPEC (the spec) and $BRIEF (the goal it must serve). The actual code is at $WORKDIR
(read-only) — check the spec's claims against it.

Attack, in order: does the Approach actually satisfy every Acceptance criterion in the brief?
Does the Changes list miss a file that must change (callers, config, migrations, tests)?
Edge cases the design ignores. A materially simpler approach. Would the Verification commands
actually fail on a wrong implementation? Risks absent from the Risks section.

Final message — first line exactly one of:
PLAN-REVIEW: SOUND
PLAN-REVIEW: ISSUES <n>
then one line per issue:
- [MUST|CONSIDER] <point> — <reasoning grounded in file:line evidence>" ;;
esac

# --- sandbox and command assembly --------------------------------------------------------
if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
  PROMPT="${PROMPT//cross-family review gate/independent review gate}"
  PROMPT="${PROMPT//Claude-family agents/separate implementation agents}"
  PROMPT="${PROMPT//non-Claude priors/an independent context}"
  PROMPT="Codex-only boundary: you are one bounded gpt-6-astra lane. Do not delegate to subagents,
launch nested model CLIs, invoke Claude, or use another model/provider. On quota, authentication,
or model failure preserve artifacts and report BLOCKED. The parent lead owns all decomposition.

$PROMPT"
fi
# Concurrent lanes must not share event logs: a named lane gets its own -<lane> suffix.
RUN_TAG="$MODE"
case "$MODE" in implement|resume) [ "$LANE" != "implement" ] && RUN_TAG="$MODE-$LANE" ;; esac
EVENTS="$TASK_DIR/codex-$RUN_TAG.jsonl"
STDERR="$TASK_DIR/codex-$RUN_TAG.stderr.log"

build_cmd() {
  CMD=(codex exec -C "$WORKDIR" --skip-git-repo-check
       -m "$MODEL" -c "model_reasoning_effort=$EFFORT")
  if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
    CMD+=(-c 'model_provider="openai"' -c 'agents.enabled=false')
  fi
  if [ "$FAST_MODE" = "1" ]; then
    CMD+=(-c "service_tier=\"$CODEX_FAST_MODE_SERVICE_TIER\"" -c "features.fast_mode=true")
  fi
  CMD+=(--json -o "$ARTIFACT")
  if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
    CMD+=(--dangerously-bypass-approvals-and-sandbox)
  else
    case "$MODE" in
      implement|resume|verify) CMD+=(--sandbox workspace-write --add-dir "$TASK_DIR") ;;
      *)                       CMD+=(--sandbox read-only) ;;
    esac
  fi
  # subcommand LAST: exec-level flags are not accepted after `resume`
  [ "$MODE" = "resume" ] && CMD+=(resume "$TID")
  CMD+=("$PROMPT")
}
build_cmd

if [ "$DRY" = "1" ]; then
  printf 'would run (timeout %ss):\n  ' "$TIMEOUT"
  printf '%q ' "timeout" "$TIMEOUT" "${CMD[@]:0:${#CMD[@]}-1}"; printf "<prompt>\n\n"
  printf -- '--- prompt ---\n%s\n' "$PROMPT"
  exit 0
fi

# --- run ---------------------------------------------------------------------------------
python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/orch-cli-update" codex || exit 2
# stdin MUST be /dev/null: with a piped-but-open stdin, codex exec waits for EOF to append a
# <stdin> block even when a prompt argument was given ("Reading additional input from stdin...")
# — measured hang under the agent harness.
mkdir -p "$STATE_DIR"
run_once() {
  local start
  start="$(date -Is)"
  env -u CC_ORCH_CODEX_ROUTE timeout "$TIMEOUT" "${CMD[@]}" < /dev/null > "$EVENTS" 2> "$STDERR"
  RC=$?
  MODEL_SPEC="$MODEL@$EFFORT"
  [ "$FAST_MODE" = "1" ] && MODEL_SPEC="$MODEL_SPEC+fast-mode"
  [ -z "$FALLBACK_NOTE" ] || MODEL_SPEC="$MODEL_SPEC ($FALLBACK_NOTE)"
  printf '%s  %-11s  %s  exit=%s  %s\n' "$start" "$MODE" "$MODEL_SPEC" "$RC" "$WORKDIR" >> "$GLOBAL_LOG"
}
run_once

# Observed on codex-cli 0.153.2 for a model the account cannot use: HTTP 400 invalid_request_error
# with "The '<model>' model is not supported". Also accept documented "This model is not supported",
# "does not exist or you do not have access", and structured model_not_found variants. JSON-escaped
# test output embedded in agent/tool events cannot match: the anchors and unescaped quotes require a
# top-level error record. The "Model metadata ... not found" warning alone is NOT decisive.
model_unavailable_signature() {
  printf '%s\n' "$1" \
    | grep -E '^(ERROR:|\{"type":"error")' \
    | grep -qE "The '[^']+' model is not supported|This model is not supported|The model .{1,80} does not exist or you do not have access to it|\"code\":[[:space:]]*\"model_not_found\""
}
if [ "$RC" -ne 0 ] && [ "$RC" -ne 124 ] && [ "$MODEL" = "gpt-6-astra" ] \
   && model_unavailable_signature "$(tail -c 4000 "$STDERR"; tail -c 4000 "$EVENTS")" \
   && use_astra_fallback "was rejected by Codex as unavailable on this account/CLI (exit $RC)"; then
  build_cmd
  run_once
fi

# Record "<lane>=<thread-id>|<model>|<effort>" so follow-ups resume with full context on the
# same model (SendMessage's equivalent). A resume updates its lane's model/effort in place —
# once a lead escalates, later follow-ups stay escalated.
LANE_KEY="$MODE"
case "$MODE" in implement|resume) LANE_KEY="$LANE" ;; esac
TID_NEW="$(grep -m1 -oE '"thread_id":"[0-9a-f-]{36}"' "$EVENTS" | cut -d'"' -f4)"
TID_NEW="${TID_NEW:-${TID:-}}"
if [ -n "$TID_NEW" ]; then
  # verify/review are intentionally launched in parallel. Serialize their session-index update
  # and use a pid-specific temp file so one gate cannot clobber another gate's thread record.
  exec 8>"$TASK_DIR/.codex-session.lock"
  flock 8
  session_tmp="$SESSION_FILE.$$.tmp"
  { sed "/^$LANE_KEY=/d" "$SESSION_FILE" 2>/dev/null; echo "$LANE_KEY=$TID_NEW|$MODEL|$EFFORT"; } \
    > "$session_tmp" && mv -f "$session_tmp" "$SESSION_FILE"
  flock -u 8
fi

# --- classify ----------------------------------------------------------------------------
if [ "$RC" -eq 124 ]; then
  echo "CODEX-RUN: TIMEOUT after ${TIMEOUT}s ($MODE, $MODEL_SPEC)" >&2
  echo "           partial events: $EVENTS — resume may continue the thread" >&2
  exit 5
fi
if [ "$RC" -ne 0 ]; then
  ERRTEXT="$(tail -c 4000 "$STDERR"; tail -c 4000 "$EVENTS")"
  if printf '%s' "$ERRTEXT" | grep -qiE 'rate.?limit|usage.?limit|quota|too many requests|429'; then
    if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
      echo 'CODEX-RUN: QUOTA_EXHAUSTED — preserve artifacts and report BLOCKED; no model/provider fallback.' >&2
    else
      echo "CODEX-RUN: QUOTA_EXHAUSTED — fall back per your lane rules (retry --fast with Luna, or Claude lane)" >&2
    fi
    exit 3
  fi
  if printf '%s' "$ERRTEXT" | grep -qiE 'unauthorized|not logged in|login required|401|invalid.*token'; then
    if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
      echo "CODEX-RUN: AUTH_ERROR — 'codex login' needed; preserve artifacts and report BLOCKED." >&2
    else
      echo "CODEX-RUN: AUTH_ERROR — 'codex login' needed on this machine; continue Claude-only" >&2
    fi
    exit 4
  fi
  if model_unavailable_signature "$ERRTEXT"; then
    if [ "${CC_ORCH_BACKEND:-claude}" = codex ]; then
      echo "CODEX-RUN: MODEL_UNAVAILABLE — '$MODEL' unavailable (exit $RC); preserve artifacts and report BLOCKED; no model/provider fallback." >&2
    else
      echo "CODEX-RUN: MODEL_UNAVAILABLE — '$MODEL' was rejected by Codex as unavailable on this account/CLI (exit $RC); pass --model sol|terra" >&2
    fi
    tail -3 "$STDERR" >&2
    exit 6
  fi
  echo "CODEX-RUN: FAILED (exit $RC) — stderr tail:" >&2
  tail -5 "$STDERR" >&2
  exit 1
fi

[ -s "$ARTIFACT" ] || { echo "CODEX-RUN: exit 0 but empty artifact $ARTIFACT — inspect $EVENTS" >&2; exit 1; }

echo "codex-run: $MODE done ($MODEL_SPEC) -> $ARTIFACT"
case "$MODE" in
  review|plan-review|verify) head -1 "$ARTIFACT" ;;
  *) [ -n "${TID_NEW:-}" ] && echo "thread: $TID_NEW (follow-up: codex-run resume ...)" ;;
esac
