#!/usr/bin/env bash
# orch-model-guard — manage role profiles and provider pressure.
#
# Polls `claude -p /usage`. When the Fable weekly bucket is spent it moves the orchestrator and
# every lead profile to Opus; when the week rolls over it restores Sonnet/Opus/Fable by role.
#
# What the switch reaches, measured rather than assumed: nothing that is already running.
# Agent definitions are read once at session start, and a session's own model is fixed when the
# process starts — no settings file, no agent file changes either afterwards. New sessions pick
# the model up from cc-orch, which reads `orch-model-guard active`; for sessions already running,
# hooks/orch-model-notice.sh tells the user to reload the named session.
#
# It also tracks the OTHER provider's weekly bucket (Codex), which costs nothing: codex-run's own
# runs leave a `rate_limits` snapshot in ~/.codex/sessions/**/rollout-*.jsonl. That number is what
# turns `lanes` from a one-sided "is Claude tired?" hint into a two-sided dispatch decision.
#
# usage:
#   orch-model-guard check              poll usage and switch if the thresholds say so
#   orch-model-guard status             what is active, why, and what the roster actually says
#   orch-model-guard active             print the active model (for scripts; always prints one)
#   orch-model-guard lanes              dispatch=codex-first unless Codex is near its reserve
#   orch-model-guard set <m>|primary|fallback|auto
#                                       force a model and pin it (auto un-pins, resumes polling)
#   orch-model-guard install            install the systemd timer + the in-session notice hook
#   orch-model-guard uninstall          remove both
set -uo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE_DIR="${CC_ORCH_STATE_DIR:-$HOME/.claude/orchestra-state}"
STATE="$STATE_DIR/state"
LOG="$STATE_DIR/guard.log"
USAGE_SNAPSHOT="$STATE_DIR/last-usage.txt"
AGENTS_DIR="${CC_ORCH_AGENTS_DIR:-$HOME/.claude/agents}"
CODEX_SESSIONS="${CODEX_HOME:-$HOME/.codex}/sessions"
HOOK="$REPO_DIR/hooks/orch-model-notice.sh"
SETTINGS="${CC_ORCH_SETTINGS:-$HOME/.claude/settings.json}"
UNIT_DIR="${CC_ORCH_UNIT_DIR:-$HOME/.config/systemd/user}"

# shellcheck source=/dev/null
. "$REPO_DIR/model-policy.conf"

mkdir -p "$STATE_DIR"

log() { printf '%s  %s\n' "$(date -Is)" "$*" >> "$LOG"; }

# --- state -------------------------------------------------------------------------------
# Flat key=value, not JSON: the notice hook runs on every user prompt and must not pay for a
# JSON parser, and nothing here is worth a dependency.
st() { [ -r "$STATE" ] && sed -n "s/^$1=//p" "$STATE" | head -1; }

active_model() { local m; m="$(st active)"; printf '%s\n' "${m:-$PRIMARY_MODEL}"; }

# The codex_* fields ride along in globals rather than three more positional arguments: every
# caller of write_state cares about the Claude switch and none of them about Codex, and they are
# carried over unchanged when nothing refreshed them.
CODEX_PCT=""; CODEX_RESETS=""; CODEX_ASOF=""

write_state() { # write_state <active> <pinned> <fable_pct> <all_pct> <session_pct> <changed_at> <reason>
  local tmp="$STATE.tmp"
  {
    printf 'active=%s\n'           "$1"
    printf 'pinned=%s\n'           "$2"
    printf 'fable_pct=%s\n'        "$3"
    printf 'all_pct=%s\n'          "$4"
    printf 'session_pct=%s\n'      "$5"
    printf 'codex_pct=%s\n'        "${CODEX_PCT:-$(st codex_pct)}"
    printf 'codex_resets_at=%s\n'  "${CODEX_RESETS:-$(st codex_resets_at)}"
    printf 'codex_asof=%s\n'       "${CODEX_ASOF:-$(st codex_asof)}"
    printf 'checked_at=%s\n'       "$(date -Is)"
    printf 'changed_at=%s\n'       "$6"
    printf 'reason=%s\n'           "$7"
    printf 'primary=%s\n'          "$PRIMARY_MODEL"
    printf 'fallback=%s\n'         "$FALLBACK_MODEL"
  } > "$tmp" && mv -f "$tmp" "$STATE"
}

# --- usage -------------------------------------------------------------------------------
claude_bin() { printf '%s\n' "${CLAUDE_BIN:-$(command -v claude 2>/dev/null)}"; }

poll_usage() {
  local bin; bin="$(claude_bin)"
  [ -x "$bin" ] || { log "ERROR: claude binary not found (set CLAUDE_BIN)"; return 1; }
  # --setting-sources project: this runs every few minutes, so it must not fire the user's
  # session hooks. --no-session-persistence keeps it out of the session list. /usage is answered
  # locally from the rate-limit endpoint — no model call, ~2s, no tokens.
  timeout 120 "$bin" -p "/usage" --model haiku --no-session-persistence --setting-sources project 2>&1
}

# Pull "Current week (<label>): NN% used" out of the panel, matching <label> loosely so a
# rename from "Fable" to "Fable 5" does not silently disable the guard.
pct_for() { # pct_for <panel-text> <label-substring>
  printf '%s\n' "$1" \
    | sed -n 's/.*Current week (\([^)]*\))[^0-9]*\([0-9]\{1,3\}\)% used.*/\1|\2/p' \
    | awk -F'|' -v want="$2" 'index(tolower($1), tolower(want)) > 0 { print $2; exit }'
}

# The 5h rolling bucket ("Current session: NN% used"). Every Claude model in the tree drains
# it, which makes it the input for the Tier 3 dispatch hint rather than the weekly guard.
pct_session() { # pct_session <panel-text>
  printf '%s\n' "$1" \
    | sed -n 's/.*Current session[^0-9]*\([0-9]\{1,3\}\)% used.*/\1/p' | head -1
}

# --- codex usage -------------------------------------------------------------------------
# The Codex CLI writes a `rate_limits` object into its rollout log on every turn, so the newest
# rollout file carries a free, current-as-of-the-last-run reading of the weekly bucket. No API
# call, no login shell-out. Measured shape (codex-cli 0.144.4):
#   "rate_limits":{"limit_id":"codex","primary":{"used_percent":1.0,"window_minutes":10080,
#                  "resets_at":1787196964},"secondary":null,...,"plan_type":"pro",...}
newest_rollout() {
  [ -d "$CODEX_SESSIONS" ] || return 1
  local today yesterday d f
  today="$(date +%Y/%m/%d)"; yesterday="$(date -d yesterday +%Y/%m/%d 2>/dev/null)"
  # Fast path first: the sessions tree grows without bound, and a full walk on a machine with
  # months of history is not something a 5-minute timer should be doing.
  for d in "$CODEX_SESSIONS/$today" "${yesterday:+$CODEX_SESSIONS/$yesterday}"; do
    [ -d "$d" ] || continue
    f="$(ls -t "$d"/rollout-*.jsonl 2>/dev/null | head -1)"
    [ -n "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  f="$(find "$CODEX_SESSIONS" -name 'rollout-*.jsonl' -printf '%T@ %p\n' 2>/dev/null \
       | sort -rn | head -1 | cut -d' ' -f2-)"
  [ -n "$f" ] && { printf '%s\n' "$f"; return 0; }
  return 1
}

# Sets CODEX_PCT / CODEX_RESETS / CODEX_ASOF, and returns non-zero when there was no usable
# snapshot. Unknown reads as "assume headroom" everywhere (see model-policy.conf).
refresh_codex_usage() {
  # "?" rather than empty: a refresh that ran and found nothing must overwrite yesterday's
  # reading in the state file, not silently inherit it. Empty is reserved for "never refreshed".
  CODEX_PCT="?"; CODEX_RESETS=""; CODEX_ASOF=""
  local f line age_h out
  f="$(newest_rollout)" || return 1
  age_h=$(( ( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ) / 3600 ))
  [ "$age_h" -gt "${CODEX_USAGE_STALE_HOURS:-24}" ] && return 1
  line="$(grep '"rate_limits"' "$f" 2>/dev/null | tail -1)" || return 1
  [ -n "$line" ] || return 1
  # python3 rather than a grep chain: the object is nested and its neighbours change between
  # codex versions, so find the key by walking the JSON instead of by counting braces.
  out="$(printf '%s' "$line" | python3 -c '
import json, sys

def find(node):
    if isinstance(node, dict):
        if "rate_limits" in node and isinstance(node["rate_limits"], dict):
            return node["rate_limits"]
        for v in node.values():
            hit = find(v)
            if hit: return hit
    elif isinstance(node, list):
        for v in node:
            hit = find(v)
            if hit: return hit
    return None

try:
    rl = find(json.loads(sys.stdin.read()))
    p = (rl or {}).get("primary") or {}
    pct = p.get("used_percent")
    if pct is None: raise ValueError
    print("%d %s" % (round(float(pct)), p.get("resets_at") or ""))
except Exception:
    sys.exit(1)
' 2>/dev/null)" || return 1
  CODEX_PCT="${out%% *}"
  CODEX_RESETS="${out#* }"; CODEX_RESETS="${CODEX_RESETS# }"
  CODEX_ASOF="$(date -Is -d "@$(stat -c %Y "$f")" 2>/dev/null)"
  return 0
}

codex_resets_human() { # epoch -> local time, or the raw value if it is not an epoch
  local v="${1:-}"
  case "$v" in
    ''|*[!0-9]*) printf '%s\n' "${v:-?}" ;;
    *)           date -d "@$v" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s\n' "$v" ;;
  esac
}

# --- applying ----------------------------------------------------------------------------
set_file_model() { # set_file_model <file> <model>
  local file="$1" model="$2"
  [ -f "$file" ] || return 1
  grep -q '^model: ' "$file" || { log "WARN: no model line in $file"; return 1; }
  sed -i "s|^model: .*|model: ${model}|" "$file"
}

apply_profiles() { # apply_profiles primary|fallback|<custom-model>
  local mode="$1" n=0 f model
  shopt -s nullglob
  for f in "$AGENTS_DIR"/lead-*.md; do
    if [ "$mode" = "fallback" ]; then
      model="$FALLBACK_MODEL"
    elif [ "$mode" = "primary" ]; then
      case "$(basename "$f")" in
        *-light.md)          model="$LEAD_LIGHT_MODEL" ;;
        *-critical.md)       model="$LEAD_CRITICAL_MODEL" ;;
        *-critical-xhigh.md) model="$LEAD_DEEP_MODEL" ;;
        *)                   model="$LEAD_NORMAL_MODEL" ;;
      esac
    else
      model="$mode"
    fi
    set_file_model "$f" "$model" && n=$((n + 1))
  done
  shopt -u nullglob
  printf '%s\n' "$n"
}

notify() { # best effort; there is usually no desktop bus behind a systemd user timer
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u critical "cc-orchestra" "$1" >/dev/null 2>&1 || true
}

# --- commands ----------------------------------------------------------------------------
cmd_check() {
  # Never let two timer firings race on the roster files.
  exec 9>"$STATE_DIR/.lock"
  flock -n 9 || exit 0

  local cur pinned changed_at panel fable all session target n
  cur="$(active_model)"
  pinned="$(st pinned)"; pinned="${pinned:-0}"
  changed_at="$(st changed_at)"

  # Free and independent of the Claude poll: read it before anything can exit early, so the
  # codex_* fields stay fresh even on a run that decides nothing.
  refresh_codex_usage || true

  panel="$(poll_usage)" || {
    log "poll failed, keeping $cur"
    # Still record the codex reading — it did not depend on the poll that just failed.
    write_state "$cur" "$pinned" "$(st fable_pct)" "$(st all_pct)" "$(st session_pct)" \
                "$changed_at" "$(st reason)"
    exit 0
  }
  printf '%s\n' "$panel" > "$USAGE_SNAPSHOT"

  fable="$(pct_for "$panel" "$FABLE_USAGE_LABEL")"
  all="$(pct_for "$panel" "all models")"
  session="$(pct_session "$panel")"

  if [ -z "$fable" ]; then
    # Either the panel changed shape or the bucket vanished. Do not guess — a wrong guess here
    # either strands the tier on a dead model or burns Opus for a week.
    log "WARN: no '$FABLE_USAGE_LABEL' weekly bucket in /usage output, keeping $cur (see $USAGE_SNAPSHOT)"
    exit 0
  fi

  if [ "$pinned" = "1" ]; then
    write_state "$cur" 1 "$fable" "${all:-?}" "${session:-?}" "$changed_at" "pinned"
    exit 0
  fi

  # Normalize state written by the pre-profile policy (for example active=fable[1m]). Only
  # PRIMARY/FALLBACK are valid automatic states; arbitrary values remain available when pinned.
  case "$cur" in
    "$PRIMARY_MODEL"|"$FALLBACK_MODEL") target="$cur" ;;
    *)                                  target="$PRIMARY_MODEL" ;;
  esac
  if   [ "$fable" -ge "$SWITCH_AT_PCT" ];  then target="$FALLBACK_MODEL"
  elif [ "$fable" -le "$RESTORE_AT_PCT" ]; then target="$PRIMARY_MODEL"
  fi

  if [ "$target" = "$cur" ]; then
    write_state "$cur" 0 "$fable" "${all:-?}" "${session:-?}" "$changed_at" "${FABLE_USAGE_LABEL} ${fable}%"
    exit 0
  fi

  if [ "$target" = "$FALLBACK_MODEL" ]; then n="$(apply_profiles fallback)"; else n="$(apply_profiles primary)"; fi
  write_state "$target" 0 "$fable" "${all:-?}" "${session:-?}" "$(date -Is)" "auto: ${FABLE_USAGE_LABEL} ${fable}% (switch>=${SWITCH_AT_PCT}, restore<=${RESTORE_AT_PCT})"
  log "SWITCH $cur -> $target  (${FABLE_USAGE_LABEL} ${fable}%, all models ${all:-?}%) — rewrote $n lead profile(s)"

  if [ "$target" = "$FALLBACK_MODEL" ]; then
    notify "Fable weekly quota spent (${fable}%). All lead profiles moved to ${target}. Running orchestrator sessions must restart."
  else
    notify "Fable weekly quota reset (${fable}%). Role-specific Sonnet/Opus/Fable profiles restored. Running orchestrator sessions must reload."
  fi
  exit 0
}

# Tier 3 / Phase A dispatch hint for leads, from BOTH providers' buckets:
#   codex-sparing  Codex's own week is nearly spent — keep what is left for the Tier 4 review
#                  gate (mandatory per task): implement on dev-*, investigate yourself, review
#                  with --fast. Checked first: it is the only state where Claude is the answer.
#   codex-first    the default — serialize a third unit rather than spill merely for speed.
# Polls Claude live (~2s, zero tokens) and falls back to the last snapshot; the Codex reading is
# a file read of the newest rollout, and unknown reads as headroom.
cmd_lanes() {
  local panel session all fable src="live"
  if ! panel="$(poll_usage)" || ! printf '%s' "$panel" | grep -q 'Current session'; then
    panel="$(cat "$USAGE_SNAPSHOT" 2>/dev/null)"
    src="snapshot from $(st checked_at)"
  else
    printf '%s\n' "$panel" > "$USAGE_SNAPSHOT"
  fi
  session="$(pct_session "$panel")"
  all="$(pct_for "$panel" "all models")"
  fable="$(pct_for "$panel" "$FABLE_USAGE_LABEL")"

  local cx csrc="live"
  if refresh_codex_usage; then cx="$CODEX_PCT"; else cx="$(st codex_pct)"; csrc="state"; fi
  case "$cx" in ''|*[!0-9]*) cx=""; csrc="unknown" ;; esac

  local hint="codex-first" why
  why="default policy — Codex owns heavy work; serialize instead of Claude spill"
  if [ -n "$cx" ] && [ "$cx" -ge "$LANES_CODEX_SPARE_PCT" ]; then
    hint="codex-sparing"; why="codex week at ${cx}% (>= ${LANES_CODEX_SPARE_PCT}) — reserve the rest for the Tier 4 gate"
  fi

  echo "dispatch=$hint"
  echo "claude: session=${session:-?}% week_all=${all:-?}% week_fable=${fable:-?}%  ($src)"
  echo "codex:  week=${cx:-?}% resets=$(codex_resets_human "${CODEX_RESETS:-$(st codex_resets_at)}")  ($csrc${CODEX_ASOF:+, asof $CODEX_ASOF})"
  echo "reason: $why"
}

cmd_status() {
  local f
  echo "policy      role profiles -> $FALLBACK_MODEL when Fable >= ${SWITCH_AT_PCT}% (restore <= ${RESTORE_AT_PCT}%)"
  echo "active      $(active_model)$([ "$(st pinned)" = "1" ] && echo "   [PINNED — auto switching is off]")"
  if [ -r "$STATE" ]; then
    echo "claude      Fable $(st fable_pct)% · all models $(st all_pct)% · 5h session $(st session_pct)%   (checked $(st checked_at))"
    # The two numbers side by side are the whole point: this harness deliberately spends the
    # Codex bucket first, and this line is where you see whether it actually is.
    echo "codex       week $(st codex_pct)% · resets $(codex_resets_human "$(st codex_resets_at)")   (asof $(st codex_asof))"
    echo "last change $(st changed_at)   $(st reason)"
  else
    echo "usage       (never polled — run: orch-model-guard check)"
  fi
  echo
  echo "roster on disk:"
  shopt -s nullglob
  for f in "$AGENTS_DIR"/orchestrator.md "$AGENTS_DIR"/lead-*.md "$AGENTS_DIR"/dev-*.md "$AGENTS_DIR"/verifier*.md; do
    printf '  %-29s %s @ %s\n' "$(basename "$f" .md)" \
      "$(sed -n 's/^model: //p' "$f" | head -1)" "$(sed -n 's/^effort: //p' "$f" | head -1)"
  done
  shopt -u nullglob
  echo "  (orchestrator.md is a symlink into the repo and keeps the primary model;"
  echo "   cc-orch passes --model from this guard, so it is the launcher that decides.)"
  echo
  printf 'timer       '
  systemctl --user is-active orch-model-guard.timer 2>/dev/null || echo "not installed"
  systemctl --user list-timers orch-model-guard.timer --no-pager 2>/dev/null | sed -n '2p'
  printf 'notice hook '
  if grep -q 'orch-model-notice.sh' "$SETTINGS" 2>/dev/null; then echo "registered in $SETTINGS"; else echo "NOT registered"; fi
}

cmd_set() {
  local want="${1:-}" model n
  case "$want" in
    primary)  model="$PRIMARY_MODEL" ;;
    fallback) model="$FALLBACK_MODEL" ;;
    auto)
      write_state "$(active_model)" 0 "$(st fable_pct)" "$(st all_pct)" "$(st session_pct)" "$(st changed_at)" "un-pinned"
      log "un-pinned, auto switching resumed"
      echo "auto switching resumed (active: $(active_model))"
      return 0 ;;
    "")  echo "usage: orch-model-guard set <model>|primary|fallback|auto" >&2; return 1 ;;
    *)   model="$want" ;;
  esac
  case "$want" in primary) n="$(apply_profiles primary)" ;; fallback) n="$(apply_profiles fallback)" ;; *) n="$(apply_profiles "$model")" ;; esac
  write_state "$model" 1 "$(st fable_pct)" "$(st all_pct)" "$(st session_pct)" "$(date -Is)" "manual pin"
  log "MANUAL $model — rewrote $n lead file(s), pinned"
  echo "active model is now $model (pinned; 'set auto' to resume polling) — $n lead file(s) rewritten"
  echo "running orchestrator sessions still need: cc-orch --reload <project>"
}

cmd_install() {
  local bin; bin="$(claude_bin)"
  [ -x "$bin" ] || { echo "ERROR: claude not on PATH — cannot pin it into the systemd unit." >&2; return 1; }

  mkdir -p "$UNIT_DIR"
  cat > "$UNIT_DIR/orch-model-guard.service" <<EOF
[Unit]
Description=cc-orchestra model guard — move all control profiles to Opus when Fable is spent

[Service]
Type=oneshot
# systemd user units get a minimal PATH; pin the claude that was on PATH at install time.
Environment=PATH=$(dirname "$bin"):/usr/local/bin:/usr/bin:/bin
ExecStart=$REPO_DIR/bin/orch-model-guard check
EOF
  cat > "$UNIT_DIR/orch-model-guard.timer" <<EOF
[Unit]
Description=Poll Claude usage every ${POLL_MINUTES} min for the cc-orchestra model guard

[Timer]
OnActiveSec=1min
OnBootSec=2min
OnUnitActiveSec=${POLL_MINUTES}min
AccuracySec=30s
Persistent=true
Unit=orch-model-guard.service

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now orch-model-guard.timer >/dev/null
  echo "  timer    orch-model-guard.timer (every ${POLL_MINUTES}m)"

  register_hook install
  echo "  hook     UserPromptSubmit -> hooks/orch-model-notice.sh in $SETTINGS"
}

cmd_uninstall() {
  systemctl --user disable --now orch-model-guard.timer >/dev/null 2>&1
  rm -f "$UNIT_DIR/orch-model-guard.timer" "$UNIT_DIR/orch-model-guard.service"
  systemctl --user daemon-reload
  register_hook uninstall
  echo "timer and notice hook removed (state kept in $STATE_DIR)"
}

# ~/.claude/settings.json is edited rather than guardrails.json on purpose: settings.json is on
# Claude Code's watch list, so a hook added here reaches sessions that are already running,
# while a --settings file is only read at startup. The hook is silent outside orch sessions.
register_hook() { # register_hook install|uninstall
  python3 - "$1" "$HOOK" "$SETTINGS" "$HOME/.claude/backups" <<'PY'
import json, os, shutil, sys, time

mode, hook, path, backup_dir = sys.argv[1:5]
settings = {}
if os.path.exists(path):
    with open(path) as fh:
        settings = json.load(fh)
    os.makedirs(backup_dir, exist_ok=True)
    shutil.copy2(path, os.path.join(backup_dir, "settings.json.%d.bak" % time.time()))

hooks = settings.setdefault("hooks", {})
entries = [e for e in hooks.get("UserPromptSubmit", [])
           if not any("orch-model-notice.sh" in h.get("command", "") for h in e.get("hooks", []))]

if mode == "install":
    entries.append({"matcher": "*", "hooks": [
        {"type": "command", "command": "bash '%s'" % hook, "timeout": 10}]})

if entries:
    hooks["UserPromptSubmit"] = entries
else:
    hooks.pop("UserPromptSubmit", None)
if not hooks:
    settings.pop("hooks", None)

tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(settings, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
os.replace(tmp, path)
PY
}

case "${1:-check}" in
  check)      cmd_check ;;
  status)     cmd_status ;;
  active)     active_model ;;
  lanes)      cmd_lanes ;;
  set)        shift; cmd_set "${1:-}" ;;
  install)    cmd_install ;;
  uninstall)  cmd_uninstall ;;
  -h|--help)  sed -n '2,29p' "$0" ;;
  *)          echo "unknown command: $1 (try --help)" >&2; exit 1 ;;
esac
