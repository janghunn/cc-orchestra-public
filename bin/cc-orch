#!/usr/bin/env bash
# cc-orch — launch the three-tier orchestrator session with Remote Control enabled.
#
# The project name is required and is not cosmetic: it labels the session, the Remote Control
# bridge, and the working directories, so several concurrent projects stay distinguishable when
# you are driving them from a phone or another machine.
set -euo pipefail

ORCH_HOME="$HOME/.claude/orchestra"
USE_RC=1

usage() {
  cat >&2 <<'EOF'
usage: cc-orch [--no-rc] <project-name> [project-dir] [extra claude args...]

  <project-name>   REQUIRED. Labels the session, the Remote Control bridge ("orch-<name>"),
                   and $CC_ORCH_PROJECT. Letters, digits, dot, dash, underscore.
  [project-dir]    Defaults to the current directory.
  --no-rc          Local only; skip the Remote Control bridge.

examples:
  cc-orch priorsplat
  cc-orch priorsplat ~/projects/priorsplat
  cc-orch priorsplat ~/projects/priorsplat -c      # resume last conversation
  cc-orch --no-rc halfres-gshead
EOF
  exit 1
}

if [[ "${1:-}" == "--no-rc" ]]; then
  USE_RC=0
  shift
fi

[[ $# -ge 1 ]] || usage
[[ "$1" == "-h" || "$1" == "--help" ]] && usage

PROJECT_NAME="$1"
shift

# Catch the easy mistake of passing the directory first — the name would silently become a path
# and every Remote Control session would be called "orch-/home/janghun/...".
if [[ -d "$PROJECT_NAME" ]]; then
  echo "cc-orch: '$PROJECT_NAME' is a directory — the project NAME comes first." >&2
  echo "         try: cc-orch $(basename "$PROJECT_NAME") $PROJECT_NAME" >&2
  exit 1
fi

if [[ ! "$PROJECT_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "cc-orch: invalid project name '$PROJECT_NAME'." >&2
  echo "         use letters, digits, dot, dash, underscore; must start alphanumeric." >&2
  exit 1
fi

PROJECT_DIR="$PWD"
if [[ $# -gt 0 && -d "$1" ]]; then
  PROJECT_DIR="$(cd "$1" && pwd)"
  shift
fi

for f in "$HOME/.claude/agents/orchestrator.md" "$ORCH_HOME/guardrails.json"; do
  if [[ ! -f "$f" ]]; then
    echo "cc-orch: missing $f — run install.sh from the cc-orchestra repo." >&2
    exit 1
  fi
done

cd "$PROJECT_DIR"
export CC_ORCH_PROJECT="$PROJECT_NAME"

args=(
  --agent orchestrator
  --model 'fable[1m]'
  --effort xhigh
  --dangerously-skip-permissions
  --settings "$ORCH_HOME/guardrails.json"
  --name "orchestrator@${PROJECT_NAME}"
)

# Remote Control publishes this session to claude.ai/code so it can be driven from a phone or
# another machine. Requires a claude.ai subscription login.
if [[ $USE_RC -eq 1 ]]; then
  args+=(--remote-control "orch-${PROJECT_NAME}")
fi

exec claude "${args[@]}" "$@"
