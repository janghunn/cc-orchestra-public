#!/usr/bin/env bash
# Persistent tmux + git-worktree operations for cc-orchestra.
set -uo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE_DIR="${CC_ORCH_STATE_DIR:-$HOME/.claude/orchestra-state}"
SESSION_DIR="$STATE_DIR/sessions"
WORKTREE_ROOT="${CC_ORCH_WORKTREE_ROOT:-$STATE_DIR/worktrees}"
TMUX_BIN="${TMUX_BIN:-tmux}"
LAUNCHER="$REPO_DIR/bin/cc-orch-runtime"
mkdir -p "$SESSION_DIR" "$WORKTREE_ROOT"

usage() {
  cat >&2 <<'HELP'
usage: cc-orch session <command> ...

  new <name> [project-dir] [options]   create worktree + detached tmux orchestra
  start|restart <name> [--no-attach]  restart a stopped session and continue Claude context
    --project-name NAME               label used by Claude Remote Control
    --branch BRANCH                   default: orch/<name>
    --base REF                        default: current branch or HEAD
    --profile normal|critical|deep
    --model MODEL --effort LEVEL      explicit launcher override
    --worktree | --inplace            worktree is default for git repos
    --reuse-branch                    attach a worktree to an existing branch
    --no-rc                           disable Claude Remote Control
    --no-attach                       return after launch instead of attaching
    -- <extra Claude arguments>

  list | ps                           show all managed sessions
  status <name>                       show one session and git state
  attach <name>                       attach to the persistent tmux session
  shell <name>                        open/attach a persistent shell window
  stop <name>                         stop the tmux session; keep branch/worktree
  remove <name> [--force]             remove stopped worktree + registry; keep branch
  path <name>                         print the working directory
HELP
  exit "${1:-2}"
}

die() { echo "cc-orch session: $*" >&2; exit 2; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }
state_file() { printf '%s/%s.conf\n' "$SESSION_DIR" "$1"; }

write_session() { # file plus key/value pairs
  local file="$1"; shift
  local tmp="$file.tmp" key value
  : > "$tmp" || return 1
  while [ $# -gt 0 ]; do
    key="$1"; value="$2"; shift 2
    printf '%s=%q\n' "$key" "$value" >> "$tmp"
  done
  chmod 600 "$tmp"
  mv -f "$tmp" "$file"
}

load_session() {
  local name="$1" file
  valid_name "$name" || die "invalid session name '$name'"
  file="$(state_file "$name")"
  [ -r "$file" ] || die "unknown session '$name' (run: cc-orch session list)"
  # State files are generated by write_session with shell-escaped values and mode 0600.
  # shellcheck disable=SC1090
  . "$file"
  SESSION_FILE="$file"
}

tmux_has() { "$TMUX_BIN" has-session -t "$1" >/dev/null 2>&1; }

quote_cmd() {
  local out="" arg q
  for arg in "$@"; do printf -v q '%q' "$arg"; out="${out}${out:+ }$q"; done
  printf '%s\n' "$out"
}

cmd_new() {
  local name="${1:-}" project_dir="$PWD" project_name="" branch="" base="" profile=normal
  local use_worktree=auto reuse_branch=0 attach=1 use_rc=1 model="" effort="" branch_created=0
  local repo workdir wt_path tmux_name launch_name file cmd current_branch
  shift || true
  [ -n "$name" ] || usage
  valid_name "$name" || die "invalid name '$name' (letters, digits, dot, dash, underscore)"
  [ ! -e "$(state_file "$name")" ] || die "session '$name' already exists"

  if [ $# -gt 0 ] && [ -d "$1" ]; then project_dir="$(cd "$1" && pwd)"; shift; fi
  extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project-name) shift; project_name="${1:-}" ;;
      --branch) shift; branch="${1:-}" ;;
      --base) shift; base="${1:-}" ;;
      --profile) shift; profile="${1:-}" ;;
      --model) shift; model="${1:-}" ;;
      --effort) shift; effort="${1:-}" ;;
      --worktree) use_worktree=1 ;;
      --inplace) use_worktree=0 ;;
      --reuse-branch) reuse_branch=1 ;;
      --no-attach) attach=0 ;;
      --attach) attach=1 ;;
      --no-rc) use_rc=0 ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown option '$1'" ;;
    esac
    shift || true
  done
  case "$profile" in normal|critical|deep) ;; *) die "invalid profile '$profile'" ;; esac
  [ -z "$effort" ] || case "$effort" in low|medium|high|xhigh|max) ;; *) die "invalid effort '$effort'" ;; esac
  command -v "$TMUX_BIN" >/dev/null 2>&1 || die "tmux is required"

  if repo="$(git -C "$project_dir" rev-parse --show-toplevel 2>/dev/null)"; then
    repo="$(cd "$repo" && pwd)"
    [ "$use_worktree" != auto ] || use_worktree=1
  else
    repo="$project_dir"
    [ "$use_worktree" != auto ] || use_worktree=0
    [ "$use_worktree" = 0 ] || die "'$project_dir' is not a git repository; use --inplace"
  fi

  project_name="${project_name:-$(basename "$repo")}"
  valid_name "$project_name" || die "invalid --project-name '$project_name'"
  branch="${branch:-orch/$name}"
  [[ "$branch" =~ ^[A-Za-z0-9._/-]+$ ]] || die "invalid branch '$branch'"
  tmux_name="ccorch-$name"
  launch_name="${project_name}-${name}"
  valid_name "$launch_name" || die "derived launcher name '$launch_name' is invalid; shorten --project-name/name"
  tmux_has "$tmux_name" && die "tmux session '$tmux_name' already exists"

  if [ "$use_worktree" = 1 ]; then
    current_branch="$(git -C "$repo" symbolic-ref --short -q HEAD 2>/dev/null)"
    base="${base:-${current_branch:-HEAD}}"
    git -C "$repo" rev-parse --verify "$base^{commit}" >/dev/null 2>&1 || die "base '$base' does not resolve to a commit"
    wt_path="$WORKTREE_ROOT/$project_name/$name"
    [ ! -e "$wt_path" ] || die "worktree path already exists: $wt_path"
    mkdir -p "$(dirname "$wt_path")"
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      [ "$reuse_branch" = 1 ] || die "branch '$branch' already exists (pass --reuse-branch)"
      git -C "$repo" worktree add "$wt_path" "$branch" >/dev/null || die "git worktree add failed"
    else
      git -C "$repo" worktree add -b "$branch" "$wt_path" "$base" >/dev/null || die "git worktree add failed"
      branch_created=1
    fi
    workdir="$wt_path"
  else
    workdir="$project_dir"
    base="${base:-inplace}"
    branch="$(git -C "$repo" symbolic-ref --short -q HEAD 2>/dev/null || echo inplace)"
  fi

  launch=("$LAUNCHER" --profile "$profile")
  [ "$use_rc" = 1 ] || launch+=(--no-rc)
  [ -z "$model" ] || launch+=(--model "$model")
  [ -z "$effort" ] || launch+=(--effort "$effort")
  launch+=("$launch_name" "$workdir")
  launch+=("${extra[@]}")
  cmd="$(quote_cmd "${launch[@]}")"

  if ! "$TMUX_BIN" new-session -d -s "$tmux_name" -c "$workdir" "$cmd"; then
    if [ "$use_worktree" = 1 ]; then
      git -C "$repo" worktree remove --force "$workdir" >/dev/null 2>&1 || true
      [ "$branch_created" = 0 ] || git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
    fi
    die "tmux launch failed"
  fi

  file="$(state_file "$name")"
  write_session "$file" \
    NAME "$name" PROJECT_NAME "$project_name" LAUNCH_NAME "$launch_name" REPO "$repo" \
    WORKDIR "$workdir" BRANCH "$branch" BASE "$base" WORKTREE "$use_worktree" \
    TMUX_SESSION "$tmux_name" PROFILE "$profile" MODEL "$model" EFFORT "$effort" \
    REMOTE_CONTROL "$use_rc" CREATED_AT "$(date -Is)"

  echo "created  $name"
  echo "tmux     $tmux_name"
  echo "workdir  $workdir"
  echo "branch   $branch"
  echo "attach   cc-orch session attach $name"
  [ "$attach" = 0 ] || exec "$TMUX_BIN" attach-session -t "$tmux_name"
}

cmd_restart() {
  local name="${1:-}" attach=1 cmd
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-attach) attach=0 ;;
      --attach) attach=1 ;;
      *) die "unknown restart option '$1'" ;;
    esac
    shift
  done
  load_session "$name"
  tmux_has "$TMUX_SESSION" && die "session '$NAME' is already running"
  [ -d "$WORKDIR" ] || die "working directory no longer exists: $WORKDIR"
  launch=("$LAUNCHER" --profile "$PROFILE")
  [ "${REMOTE_CONTROL:-1}" = 1 ] || launch+=(--no-rc)
  [ -z "${MODEL:-}" ] || launch+=(--model "$MODEL")
  [ -z "${EFFORT:-}" ] || launch+=(--effort "$EFFORT")
  launch+=("$LAUNCH_NAME" "$WORKDIR" -c)
  cmd="$(quote_cmd "${launch[@]}")"
  "$TMUX_BIN" new-session -d -s "$TMUX_SESSION" -c "$WORKDIR" "$cmd" || die "tmux relaunch failed"
  echo "restarted $NAME"
  echo "attach    cc-orch session attach $NAME"
  [ "$attach" = 0 ] || exec "$TMUX_BIN" attach-session -t "$TMUX_SESSION"
}

cmd_list() {
  local file status branch path name
  printf '%-20s %-9s %-28s %s\n' NAME STATUS BRANCH WORKDIR
  shopt -s nullglob
  for file in "$SESSION_DIR"/*.conf; do
    unset NAME BRANCH WORKDIR TMUX_SESSION
    # shellcheck disable=SC1090
    . "$file"
    name="${NAME:-$(basename "$file" .conf)}"; branch="${BRANCH:-?}"; path="${WORKDIR:-?}"
    if [ -n "${TMUX_SESSION:-}" ] && tmux_has "$TMUX_SESSION"; then status=running; else status=stopped; fi
    printf '%-20s %-9s %-28s %s\n' "$name" "$status" "$branch" "$path"
  done
  shopt -u nullglob
}

cmd_status() {
  load_session "${1:-}"
  local status=stopped dirty="n/a"
  tmux_has "$TMUX_SESSION" && status=running
  if git -C "$WORKDIR" rev-parse --git-dir >/dev/null 2>&1; then
    [ -z "$(git -C "$WORKDIR" status --porcelain 2>/dev/null)" ] && dirty=clean || dirty=dirty
  fi
  cat <<EOF2
name       $NAME
status     $status
tmux       $TMUX_SESSION
project    $PROJECT_NAME
repo       $REPO
workdir    $WORKDIR
branch     $BRANCH
worktree   $WORKTREE
git        $dirty
profile    $PROFILE
created    $CREATED_AT
EOF2
}

cmd_attach() {
  load_session "${1:-}"
  tmux_has "$TMUX_SESSION" || die "session '$NAME' is stopped"
  if [ -n "${TMUX:-}" ]; then
    exec "$TMUX_BIN" switch-client -t "$TMUX_SESSION"
  else
    exec "$TMUX_BIN" attach-session -t "$TMUX_SESSION"
  fi
}

cmd_shell() {
  load_session "${1:-}"
  tmux_has "$TMUX_SESSION" || die "session '$NAME' is stopped"
  if ! "$TMUX_BIN" list-windows -t "$TMUX_SESSION" -F '#W' 2>/dev/null | grep -qx shell; then
    "$TMUX_BIN" new-window -d -t "$TMUX_SESSION" -n shell -c "$WORKDIR"
  fi
  "$TMUX_BIN" select-window -t "$TMUX_SESSION:shell" >/dev/null 2>&1 || true
  if [ -n "${TMUX:-}" ]; then
    exec "$TMUX_BIN" switch-client -t "$TMUX_SESSION"
  else
    exec "$TMUX_BIN" attach-session -t "$TMUX_SESSION"
  fi
}

cmd_stop() {
  load_session "${1:-}"
  if ! tmux_has "$TMUX_SESSION"; then echo "already stopped: $NAME"; return 0; fi
  "$TMUX_BIN" send-keys -t "$TMUX_SESSION" C-c >/dev/null 2>&1 || true
  sleep "${CC_ORCH_STOP_GRACE_SECONDS:-1}"
  "$TMUX_BIN" kill-session -t "$TMUX_SESSION" >/dev/null 2>&1 || true
  echo "stopped $NAME (branch/worktree kept)"
}

cmd_remove() {
  local name="${1:-}" force=0
  shift || true
  [ "${1:-}" != --force ] || force=1
  load_session "$name"
  if tmux_has "$TMUX_SESSION"; then
    [ "$force" = 1 ] || die "'$NAME' is running; stop it first or pass --force"
    cmd_stop "$NAME"
    load_session "$NAME"
  fi
  if [ "$WORKTREE" = 1 ] && [ -d "$WORKDIR" ]; then
    if [ -n "$(git -C "$WORKDIR" status --porcelain 2>/dev/null)" ] && [ "$force" = 0 ]; then
      die "worktree is dirty: $WORKDIR (commit/stash, or pass --force)"
    fi
    if [ "$force" = 1 ]; then
      git -C "$REPO" worktree remove --force "$WORKDIR" >/dev/null || die "worktree removal failed"
    else
      git -C "$REPO" worktree remove "$WORKDIR" >/dev/null || die "worktree removal failed"
    fi
  fi
  rm -f "$SESSION_FILE"
  echo "removed  $NAME"
  echo "kept     branch $BRANCH"
}

case "${1:-}" in
  new) shift; cmd_new "$@" ;;
  start|restart) shift; cmd_restart "$@" ;;
  list|ps) cmd_list ;;
  status) shift; cmd_status "$@" ;;
  attach) shift; cmd_attach "$@" ;;
  shell) shift; cmd_shell "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  remove|rm) shift; cmd_remove "$@" ;;
  path) shift; load_session "${1:-}"; echo "$WORKDIR" ;;
  -h|--help|help|"") usage 0 ;;
  *) die "unknown command '$1'" ;;
esac
