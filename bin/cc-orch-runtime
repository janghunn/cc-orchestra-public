#!/usr/bin/env bash
# cc-orch facade: preserve the existing launcher and add persistent session/worktree commands.
# Runtime quota routing happens at lead/Codex dispatch boundaries; the already-running Tier-1
# orchestrator keeps its launch profile and context.
set -uo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CORE="$REPO_DIR/bin/cc-orch"
SESSION="$REPO_DIR/bin/cc-orch-session"

# Select the backend before touching any Claude launcher or quota path.
if [ "${1:-}" = --backend ]; then
  [ "$#" -ge 2 ] || { echo 'cc-orch: --backend needs hybrid or codex' >&2; exit 2; }
  export CC_ORCH_BACKEND="$2"
  shift 2
fi
case "${CC_ORCH_BACKEND:-claude}" in
  codex) exec "$REPO_DIR/bin/cc-orch-codex" "$@" ;;
  claude|hybrid) export CC_ORCH_BACKEND=claude ;;
  *) echo 'cc-orch: backend must be hybrid (alias: claude) or codex' >&2; exit 2 ;;
esac

[ -x "$CORE" ] || { echo "cc-orch: missing $CORE" >&2; exit 2; }

case "${1:-}" in
  session|sessions)
    shift
    exec "$SESSION" "$@"
    ;;
  *)
    # Pass a one-shot runtime launch marker. The core consumes and clears it so the signal cannot
    # leak into nested direct launches; critical/deep retain legacy Fable-exhaustion protection.
    export CC_ORCH_RUNTIME_ROUTING_LAUNCH=1
    exec "$CORE" "$@"
    ;;
esac
