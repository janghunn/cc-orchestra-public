import urllib.parse
import urllib.request
import warnings

REPO_DIR = Path(__file__).resolve().parent.parent
DEFAULTS = {
    "JEV_ENABLED": "1", "JEV_MODEL": "jev-1.13.0",
    "JEV_ENDPOINT": "https://api.typesafe.ai/v1/systemone",
    "JEV_TIMEOUT_SECONDS": 6.0, "JEV_MAX_STATE_BYTES": 24000,
    "JEV_LINT_MAX_ITEMS": 20, "JEV_LINT_THRESHOLD": 0.5,
    "JEV_RISK_MIN_CONFIDENCE": 0.6, "JEV_SCAN_CHUNK_BYTES": 4000,
    "JEV_SCAN_MAX_CHUNKS": 24, "JEV_SCAN_THRESHOLD": 0.7, "JEV_JOURNAL": "1",
    "JEV_SHADOW_ENABLED": "0",
    "JEV_SHADOW_MAP_MECHANICAL": "gpt-6-luna@medium",
    "JEV_SHADOW_MAP_ROUTINE": "gpt-6-astra@high",
    "JEV_SHADOW_MAP_INVOLVED": "gpt-6-astra@xhigh",
    "JEV_SHADOW_MAP_NOVEL": "gpt-6-astra@xhigh",
    "JEV_SHADOW_MIN_CONFIDENCE": 0.6,
    "JEV_SHADOW_MAX_BYTES": 12000,
    "JEV_SHADOW_TIMEOUT_SECONDS": 5700,
    "JEV_SHADOW_LOG": "codex-shadow.jsonl",
    "JEV_LOCAL_ENABLED": "0",
    "JEV_LOCAL_SOCKET": "jev-local/llama.sock",
    "JEV_LOCAL_MODEL_PATH": "models/Qwen3-8B-Q8_0.gguf",
    "JEV_LOCAL_MODEL_DIGEST": "408b955510e196121c1c375201744783b5c9a43c7956d73fc78df54c66e883d6",
    "JEV_LOCAL_SERVER_BIN": "llama-server",
    "JEV_LOCAL_GPU": "0",
    "JEV_LOCAL_TIMEOUT_SECONDS": 10,
    "JEV_LOCAL_DEADLINE_SECONDS": 60,
    "JEV_LOCAL_LOG": "jev-local.jsonl",
}
TIERS = ("trivial", "low", "normal", "critical")
DIFFICULTIES = ("mechanical", "routine", "involved", "novel")
RESPONSE_MAX_BYTES = 1_048_576
SECRET_FLAGS = re.ASCII | re.IGNORECASE
WS_CLASS = r"[ \t\r\n\x0b\x0c\x1c-\x1f\x85\xa0\u2028\u2029\u200b\ufeff]"
WS = WS_CLASS + "*"
ASSIGNMENT = r'''(key|token|secret|password|api[_-]?key|passwd|bearer|authorization)["']?''' + WS + r"[:=]" + WS
GENERIC = re.compile(r"(^|[^A-Za-z0-9_])" + ASSIGNMENT + r'''["']?''' + WS + r"([A-Za-z0-9_/+=.-]{20,})", SECRET_FLAGS)
ASSEMBLED = re.compile(ASSIGNMENT + r'''["']?''' + WS + r"([A-Za-z0-9_/+=.-]{20,})", SECRET_FLAGS)
SOURCE_ASSIGNMENT = re.compile(ASSIGNMENT, SECRET_FLAGS)
PLACEHOLDER = re.compile(r"example|xxx|changeme|your_|redacted|dummy|placeholder|<[a-z_]+>|\$\{|todo", SECRET_FLAGS)
AWS = re.compile(r"AKIA[0-9A-Z]{16}", SECRET_FLAGS)
BEARER = re.compile(r"bearer" + WS + r"[A-Za-z0-9_./+=-]{16,}", SECRET_FLAGS)
PEM = re.compile(r"-----BEGIN[ A-Z]*PRIVATE KEY-----", SECRET_FLAGS)
TERMINATORS = re.compile(r"\r\n|\r|\n|\x0b|\x0c|\x1c|\x1d|\x1e|\x85|\u2028|\u2029")
RISK_ANCHOR = re.compile(r"^\s*(-\s*)?RISK:\s*\**([a-z]*)")
USAGE = "usage: orch-jev lint-brief <brief.md> | risk <brief.md> | scan <file>... | - | --help | shadow <flags> | shadow-report [--log <path>]"


def emit(line):
    if (not line.startswith("JEV: ") or "RISK:" in line or "RISK AMENDED" in line
            or any(ord(c) < 32 or 127 <= ord(c) <= 159 or c in "\u2028\u2029" for c in line)):
        line = "JEV: unavailable — output guard"
    print(line)


def display_name(name):
    name = re.sub(r"[\x00-\x1f\x7f-\x9f\u2028\u2029]|RISK:|RISK AMENDED", "?", str(name))
    return name[:60] + "…" + name[-59:] if len(name) > 120 else name


def state_dir():
    return Path(os.environ.get("CC_ORCH_STATE_DIR") or Path.home() / ".claude/orchestra-state")


class Policy:
    def __init__(self):
        self.values = dict(DEFAULTS)
        try:
            text = Path(os.environ.get("CC_ORCH_JEV_POLICY") or REPO_DIR / "jev-policy.conf").read_text()
        except (OSError, UnicodeError):
            text = ""
        for line in text.splitlines():
            match = re.fullmatch(r"\s*([A-Z_]+)\s*=\s*(.*?)\s*", line)
            if not match or match[1] not in DEFAULTS:
                continue
            name, value = match.groups()
            parsed = re.fullmatch(r'''(?:"([^"\n]*)"|'([^'\n]*)'|([^\s'"#]*))(?:\s+#.*)?''', value)
            if not parsed:
                if name in ("JEV_MODEL", "JEV_ENDPOINT"):
                    self.values[name] = ""
                continue
            value = next(v for v in parsed.groups() if v is not None)
            default = DEFAULTS[name]
            try:
                if isinstance(default, int):
                    value = int(value)
                    valid = value >= 1
                elif isinstance(default, float):
                    value = float(value)
                    valid = 0 < value <= 15 if name == "JEV_TIMEOUT_SECONDS" else 0 <= value <= 1
                else:
                    valid = True
                self.values[name] = value if valid else default
            except ValueError:
                self.values[name] = default
        self.model = self.values["JEV_MODEL"]
        self.timeout = self.values["JEV_TIMEOUT_SECONDS"]
        self.attempts = 0

    def __getitem__(self, key):
        return self.values["JEV_" + key]

    def valid(self):
        try:
            endpoint = self["ENDPOINT"]
            url = urllib.parse.urlsplit(endpoint)
            return bool(re.fullmatch(r"jev-\d+\.\d+\.\d+", self.model)
                        and not any(ord(c) <= 32 or ord(c) == 127 for c in endpoint)
                        and url.username is None and url.password is None
                        and "?" not in endpoint and "#" not in endpoint
                        and (url.port is None or 0 < url.port <= 65535)
                        and ((url.scheme == "https" and url.hostname == "api.typesafe.ai")
                             or (url.scheme in ("http", "https")
                                 and url.hostname in ("127.0.0.1", "localhost", "::1"))))
        except ValueError:
            return False


def read_key():
    value = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if value:
        return value
    try:
        path = state_dir() / "jev.key"
        info = path.stat()
        mode = stat.S_IMODE(info.st_mode)
        if mode & 0o077:
            emit(f"JEV: warning — jev.key ignored (mode 0{mode:o} permits group/other access; chmod 600 it)")
        elif not stat.S_ISREG(info.st_mode):
            emit("JEV: warning — jev.key unreadable; ignored")
        else:
            return path.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        pass
    except (OSError, UnicodeError):
        emit("JEV: warning — jev.key unreadable; ignored")
    return ""


def load_template(command):
    try:
        directory = Path(os.environ.get("CC_ORCH_JEV_TEMPLATES") or REPO_DIR / "templates/jev")
        template = json.loads((directory / (command + ".json")).read_text(encoding="utf-8"))
        expected = "choice" if command in ("risk", "difficulty") else "noul"
        criteria = DIFFICULTIES if command == "difficulty" else TIERS
        if (isinstance(template, dict) and template.get("type") == expected
                and isinstance(template.get("instructions"), str)
                and (expected != "choice" or (isinstance(template.get("criteria"), dict)
                                             and set(template["criteria"]) == set(criteria)))):
            return template
    except (OSError, ValueError, UnicodeError):
        pass
    return None


def secret_shaped(text):
    lines = text.split("\n")
    stripped_lines = [re.sub(WS_CLASS, "", line) for line in lines]
    stripped = re.sub(WS_CLASS, "", text)
    views = [text, *lines, *TERMINATORS.split(text), stripped]
    if any(AWS.search(segment) or BEARER.search(segment) or PEM.search(segment) for segment in views):
        return True
    if any((GENERIC.search(line) or GENERIC.search(compact)) and not PLACEHOLDER.search(line)
           for line, compact in zip(lines, stripped_lines)):
        return True
    if any("\n" in match.group(0) for match in GENERIC.finditer(text)):
        return True
    return (sum(1 for _ in ASSEMBLED.finditer(stripped))
            > sum(1 for line in stripped_lines for _ in ASSEMBLED.finditer(line)))


def secret_source_name(name):
    # Filename prefixes (including xxx) must not hide an attached assignment.
    return secret_shaped(name) or any(secret_shaped(name[match.start():])
                                     for match in SOURCE_ASSIGNMENT.finditer(name))


def state_strings(state):
    # Check strings before JSON quoting as well as the exact serialized state.
    if isinstance(state, str):
        yield state
    elif isinstance(state, dict):
        for name, value in state.items():
            yield name
            yield from state_strings(value)
    elif isinstance(state, list):
        for value in state:
            yield from state_strings(value)


def strip_fences(text):
    fence, length, result = "", 0, []
    if "\0" in text:
        return ""
    for line in text.splitlines(keepends=True):
        match = re.match(r"^\s*(`{3,}|~{3,})", line)
        if match:
            run = match[1]
            # An inline span starting with ``` and containing a later backtick opened
            # a false fence, hiding later RISK: lines. CommonMark forbids backticks in
            # backtick fence info strings, so keep such lines visible as text.
            if not fence and not (run[0] == "`" and "`" in line[match.end():]):
                fence, length = run[0], len(run)
                continue
            if run[0] == fence and len(run) >= length and not line[match.end():].strip():
                fence = ""
                continue
        if not fence:
            result.append(line)
    return "".join(result)


def section(text, name):
    lines, active = [], False
    for line in text.splitlines():
        if active and line.startswith("## "):
            break
        elif re.match(r"^##\s+" + name + r"\b", line):
            active = True
        elif active:
            lines.append(line)
    return "\n".join(lines)


def risk_state(text):
    result, in_risk = [], False
    for line in text.splitlines(keepends=True):
        if re.match(r"^##\s+Risk\b", line):
            in_risk = True
        elif line.startswith("## "):
            in_risk = False
        if not in_risk and not RISK_ANCHOR.match(line) and not line.startswith("DEEP REASONING:"):
            result.append(line)
    return "".join(result)


def chunks(text, source, cap):
    result, buffer, size, first, last = [], [], 0, 1, 1
    lines = text.split("\n")
    for number, line in enumerate(lines, 1):
        if number < len(lines):
            line += "\n"
        if buffer and size + len(line.encode()) > cap:
            result.append({"source": source, "lines": f"{first}-{last}", "text": "".join(buffer)})
            buffer, size = [], 0
        for char in line:
            width = len(char.encode())
            if width > cap:
                return None  # No codepoint-preserving split can satisfy this cap.
            if size + width > cap:
                result.append({"source": source, "lines": f"{first}-{last}", "text": "".join(buffer)})
                buffer, size = [], 0
            if not buffer:
                first = number
            buffer.append(char)
            size, last = size + width, number
    if buffer:
        result.append({"source": source, "lines": f"{first}-{last}", "text": "".join(buffer)})
    return result


def state_size(state):
    return len(json.dumps(state, ensure_ascii=False).encode())


def trim_state(command, state, cap):
    before = state_size(state)
    while state_size(state) > cap:
        if command == "risk":
            if not state:
                break
            state = "".join(state.splitlines(keepends=True)[:-1])
        elif command == "lint-brief" and state["verification"]:
            state["verification"] = "\n".join(state["verification"].splitlines()[:-1])
        else:
            items = state["acceptance" if command == "lint-brief" else "chunks"]
            if not items:
                break
            items.pop()
    after = state_size(state)
    if after != before:
        emit(f"JEV: note — state truncated to {after} of {before} bytes")
    return state


def prepare(command, sources, policy, template):
    items, state, declared, reason = [], None, None, "empty"
    positions = []
    for position, path in enumerate(sources, 1):
        if secret_source_name(str(path)) or secret_source_name(display_name(path)):
            emit(f"JEV: skipped — secret-shaped literal (argument {position}: source name)")
            reason = "secret-shaped"
            continue
        source = display_name("<stdin>" if command == "scan" and path == "-" else path)
        try:
            if command == "scan" and path == "-":
                raw = sys.stdin.buffer.read().decode("utf-8", errors="replace") if hasattr(sys.stdin, "buffer") else sys.stdin.read()
            else:
                with Path(path).open(encoding="utf-8", errors="replace", newline="") as stream:
                    raw = stream.read()
        except (OSError, ValueError, UnicodeError):
            emit(f"JEV: skipped — cannot read {source}")
            reason = "unreadable"
            continue
        if secret_shaped(raw):
            hit = next((n for n, line in enumerate(raw.split("\n"), 1) if secret_shaped(line)), "*")
            emit(f"JEV: skipped — secret-shaped literal ({source}:{hit})")
            reason = "secret-shaped"
            continue
        if command == "risk":
            match = next((RISK_ANCHOR.match(line) for line in strip_fences(raw).splitlines()
                          if RISK_ANCHOR.match(line)), None)
            declared = match[2] if match and match[2] in TIERS else None
            state = risk_state(raw)
        elif command == "lint-brief":
            text = strip_fences(raw)
            for line in section(text, "Acceptance").splitlines():
                match = re.match(r"^\s*(\d+)[.)]\s+(.*)", line)
                if match:
                    items.append({"item": match[1], "text": match[2]})
                elif items and line.strip():
                    items[-1]["text"] += " " + line.strip()
            if not items:
                emit("JEV: lint — no numbered acceptance items found")
                return None, {}, None, "no-items", {}
            state = {"acceptance": items, "verification": section(text, "Verification")}
        else:
            parts = chunks(raw, source, policy["SCAN_CHUNK_BYTES"])
            if parts is None:
                emit(f"JEV: skipped — chunk cap smaller than a codepoint ({source})")
                reason = "chunk-cap"
            elif not parts:
                emit(f"JEV: scan — {source}: empty")
            else:
                positions.extend([position] * len(parts))
                items.extend(parts)
    if command == "scan":
        if not items:
            return None, {}, None, reason, {}
        state = {"chunks": items}
    elif state is None:
        return None, {}, None, reason, {}
    if command != "risk":
        cap = policy["LINT_MAX_ITEMS" if command == "lint-brief" else "SCAN_MAX_CHUNKS"]
        if len(items) > cap:
            kind = "acceptance items" if command == "lint-brief" else "chunks"
            emit(f"JEV: note — {len(items)} {kind} found; only the first {cap} were sent")
            del items[cap:]
        if command == "scan":
            for n, item in enumerate(items, 1):
                item["id"] = f"c{n}"
    state = trim_state(command, state, policy["MAX_STATE_BYTES"])
    if state_size(state) > policy["MAX_STATE_BYTES"] or not (state.strip() if command == "risk" else items):
        emit("JEV: skipped — nothing to send after truncation")
        return None, {}, declared, "truncation", {}
    questions = {"tier": template} if command == "risk" else {}
    for n, item in enumerate(items, 1):
        label = item["item"] if command == "lint-brief" else item["id"]
        token = "{n}" if command == "lint-brief" else "{chunk}"
        questions[f"q{n}" if command == "lint-brief" else label] = dict(
            template, instructions=template["instructions"].replace(token, label))
    chunk_sources = {item["id"]: position for item, position in zip(items, positions)}
    return state, questions, declared, None, chunk_sources


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def valid_response(payload, questions):
    if not isinstance(payload, dict) or not isinstance(payload.get("model"), str) or not isinstance(payload.get("answers"), dict):
        return False
    for name, question in questions.items():
        answer = payload["answers"].get(name)
        if not isinstance(answer, dict) or answer.get("type") != question["type"]:
            return False
        field = "noul" if question["type"] == "noul" else "confidence"
        value = answer.get(field)
        if type(value) not in (int, float) or not 0 <= value <= 1:
            return False
        if field == "confidence" and (not isinstance(answer.get("choice"), str) or answer["choice"] not in question.get("criteria", {})):
            return False
    return True


def request_attempt(request, timeout, questions):
    start = time.monotonic()
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
        with opener.open(request, timeout=timeout) as response:
            if response.status != 200:
                return f"http {response.status}", None
            body = bytearray()
            while True:
                remaining = timeout - (time.monotonic() - start)
                if remaining <= 0:
                    raise TimeoutError
                try:
                    response.fp.raw._sock.settimeout(remaining)
                except (AttributeError, OSError):
                    pass
                # read1 returns after one buffered/socket read, including a slow drip.
                part = response.read1(65536)
                if time.monotonic() - start > timeout:
                    raise TimeoutError
                body.extend(part)
                if len(body) > RESPONSE_MAX_BYTES:
                    return "malformed response", None
                if not part or response.fp is None:
                    break
        try:
            payload = json.loads(body)
        except (ValueError, UnicodeError, RecursionError):
            return "malformed response", None
        return ("ok", payload) if valid_response(payload, questions) else ("schema", None)
    except urllib.error.HTTPError as error:
        code = error.code
        error.close()
        kind = {401: "auth", 403: "auth", 422: "validation", 429: "rate limit", 529: "overloaded"}.get(code)
        kind = "redirect" if 300 <= code < 400 else kind
        outcome = f"{kind} (HTTP {code})" if kind else f"http {code}"
    except (TimeoutError, socket.timeout):
        outcome = "timeout"
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError, UnicodeError) as error:
        outcome = "timeout" if isinstance(getattr(error, "reason", None), (TimeoutError, socket.timeout)) else "network"
    return outcome, None


def run_attempt(request, timeout, questions, result):
    try:
        result.append(request_attempt(request, timeout, questions))
    except Exception:
        result.append(("internal error", None))


def call_jev(policy, key, state, questions):
    request = urllib.request.Request(policy["ENDPOINT"],
        data=json.dumps({"state": state, "model": policy.model, "questions": questions}, ensure_ascii=False).encode(),
        headers={"Authorization": "Bearer " + key, "Content-Type": "application/json",
                 "Accept": "application/json", "User-Agent": "cc-orchestra-orch-jev"}, method="POST")
    for attempt in range(2):
        policy.attempts = attempt + 1
        result = []
        worker = threading.Thread(target=run_attempt, args=(request, policy.timeout, questions, result), daemon=True)
        worker.start()
        worker.join(policy.timeout)
        outcome, payload = ("timeout", None) if worker.is_alive() else result[0]
        if outcome not in ("timeout", "network", "rate limit (HTTP 429)", "overloaded (HTTP 529)") or attempt == 1:
            return outcome, payload
        time.sleep(0 if outcome == "timeout" else 0.5)


def journal(record):
    try:
        directory = state_dir()
        directory.mkdir(parents=True, exist_ok=True)
        with os.fdopen(os.open(directory / "jev.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "a") as stream:
            fcntl.flock(stream, fcntl.LOCK_EX)
            os.fchmod(stream.fileno(), 0o600)
            stream.write(json.dumps(record) + "\n")
    except Exception:
        pass


def results(command, state, answers, declared, policy, chunk_sources):
    if command == "risk":
        choice, confidence = answers["tier"]["choice"], answers["tier"]["confidence"]
        if declared is None:
            emit(f"JEV: risk — no tier declared in brief; jev picks {choice} (confidence {confidence:.2f}); advisory only")
        elif TIERS.index(choice) > TIERS.index(declared) and confidence >= policy["RISK_MIN_CONFIDENCE"]:
            emit(f"JEV: risk — declared {declared}; jev suggests {choice} (confidence {confidence:.2f}); advisory only, the brief is unchanged")
        else:
            emit(f"JEV: risk — declared {declared}; no escalation suggested (jev: {choice}, confidence {confidence:.2f})")
    elif command == "lint-brief":
        values = [answers[f"q{n}"]["noul"] for n in range(1, len(state["acceptance"]) + 1)]
        for item, value in zip(state["acceptance"], values):
            if value < policy["LINT_THRESHOLD"]:
                emit(f"JEV: lint — item {item['item']} may not be checkable (p={value:.2f})")
        if min(values) >= policy["LINT_THRESHOLD"]:
            emit(f"JEV: lint — all {len(values)} acceptance items look checkable (min p={min(values):.2f})")
    else:
        sources = {}
        for chunk in state["chunks"]:
            value, source = answers[chunk["id"]]["noul"], chunk["source"]
            position = chunk_sources[chunk["id"]]
            sources[position] = (source, max(value, sources.get(position, (source, 0))[1]))
            if value >= policy["SCAN_THRESHOLD"]:
                emit(f"JEV: scan — {source}:{chunk['lines']} possible agent-directed instruction (p={value:.2f})")
        for source, value in sources.values():
            if value < policy["SCAN_THRESHOLD"]:
                emit(f"JEV: scan — {source}: no chunk over threshold (max p={value:.2f})")


# Shadow uses its own bounded journal; the advisory journal and dispatch stay independent.
SHADOW_KEYS = (
    "timestamp", "id", "lane", "thread_id", "mode", "status", "jev_model", "difficulty",
    "difficulty_confidence", "reasoning", "suggested_model", "suggested_effort", "suggested_reason",
    "initial_model", "initial_effort", "initial_fast_mode", "final_model", "final_effort",
    "final_fast_mode", "final_fallback_from", "attempts", "observation", "explicit_flags",
    "pressure", "codex_exit", "duration_ms", "jev_latency_ms", "jev_attempts", "input_tokens", "truncated",
)
SHADOW_TYPES = {
    **dict.fromkeys(("timestamp", "id", "lane", "mode", "status", "observation"), (str,)),
    **dict.fromkeys(("thread_id", "jev_model", "difficulty", "suggested_model", "suggested_effort",
                     "suggested_reason", "initial_model", "initial_effort", "final_model",
                     "final_effort", "final_fallback_from", "pressure"), (str, type(None))),
    **dict.fromkeys(("attempts", "jev_attempts"), (int,)),
    **dict.fromkeys(("codex_exit", "duration_ms", "jev_latency_ms", "input_tokens"), (int, type(None))),
    **dict.fromkeys(("difficulty_confidence", "reasoning"), (float, int, type(None))),
    **dict.fromkeys(("explicit_flags", "truncated"), (bool,)),
    **dict.fromkeys(("initial_fast_mode", "final_fast_mode"), (bool, type(None))),
}
SHADOW_PAIR = re.compile(r"^([a-z0-9.-]{1,64})@(low|medium|high|xhigh|max|ultra)$")
CODEX_LOG_LINE = re.compile(
    r"^(\S+)  (\S+)\s+(\S+?)(?:\+fast-mode)?(?: \(fallback-from:(\S+)\))?  exit=(-?\d+)  (.*)$")
EFFORT_RANK = {name: n for n, name in enumerate(("low", "medium", "high", "xhigh", "max", "ultra"))}
MODEL_RANK = {"gpt-5.6-luna": 0, "gpt-6-luna": 0, "gpt-5.6-terra": 1, "gpt-5.6-sol": 1, "gpt-6-sol": 1, "gpt-6-astra": 2}


def map_difficulty(policy, difficulty, confidence):
    if difficulty is None:
        return None, None, "no-answer"
    if type(confidence) not in (int, float) or not 0 <= confidence <= 1 or confidence < policy["SHADOW_MIN_CONFIDENCE"]:
        return None, None, "low-confidence"
    if difficulty not in DIFFICULTIES:
        return None, None, "unmapped"
    pair = SHADOW_PAIR.fullmatch(policy["SHADOW_MAP_" + difficulty.upper()])
    return (*pair.groups(), "mapped") if pair else (None, None, "unmapped")


def shadow_log_path(policy):
    path = Path(policy["SHADOW_LOG"])
    return path if path.is_absolute() else state_dir() / path


def append_shadow(policy, record):
    fd = None
    try:
        line = (json.dumps(record, ensure_ascii=True) + "\n").encode()
        path = shadow_log_path(policy)
        path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NONBLOCK | os.O_NOFOLLOW, 0o600)
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return False
        try:
            os.fchmod(fd, 0o600)
        except OSError:
            pass
        deadline = time.monotonic() + 2.0
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.01)
        return os.write(fd, line) == len(line)
    except Exception:
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def diagnose(correlation_id, status):
    fd = None
    try:
        directory = state_dir()
        directory.mkdir(parents=True, exist_ok=True)
        line = (f"{datetime.datetime.now().astimezone().isoformat(timespec='seconds')}  "
                f"JEV: shadow {correlation_id} — {status}\n").encode()
        fd = os.open(directory / "guard.log",
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NONBLOCK | os.O_NOFOLLOW, 0o600)
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return
        os.write(fd, line)
    except Exception:
        pass
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def shadow_deadline(record, policy):
    record["status"] = "unavailable:deadline"
    if record["observation"] in (None, "none"):
        record["observation"] = "timeout"
    append_shadow(policy, record)
    diagnose(record["id"], record["status"])
    os._exit(0)


def shadow_flags(args, defaults):
    values = dict(defaults)
    for i in range(0, len(args), 2):
        if args[i] not in values or i + 1 == len(args):
            raise ValueError
        values[args[i]] = args[i + 1]
    return values


def shadow_session(task_dir, lane):
    try:
        with (Path(task_dir) / ".codex-session").open(encoding="utf-8") as stream:
            for line in stream:
                if line.startswith(lane + "="):
                    return line.rstrip("\n").split("=", 1)[1]
    except (OSError, ValueError, UnicodeError):
        pass
    return None


def shadow_observe(policy, record, flags, t0, snapshot, log_offset):
    try:
        pid = int(flags["--pid"])
    except ValueError:
        pid = 0
    deadline = t0 + policy["SHADOW_TIMEOUT_SECONDS"]
    while pid > 0:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            break
        except PermissionError:
            pass  # Alive, even if a different uid now owns the pid.
        if time.time() >= deadline:
            record.update(observation="timeout", duration_ms=int((time.time() - t0) * 1000))
            return
        time.sleep(0.25)
    record["duration_ms"] = int((time.time() - t0) * 1000)
    workdirs = {os.path.abspath(flags["--workdir"]), os.path.realpath(flags["--workdir"])}
    kept = []
    truncated = False
    try:
        with (state_dir() / "codex.log").open(encoding="utf-8", errors="replace") as stream:
            truncated = os.fstat(stream.fileno()).st_size < log_offset
            stream.seek(0 if truncated else log_offset)
            for line in stream:
                match = CODEX_LOG_LINE.fullmatch(line.rstrip("\n"))
                if not match:
                    continue
                start, mode, pair, fallback, rc, workdir = match.groups()
                try:
                    recent = datetime.datetime.fromisoformat(start).timestamp() >= math.floor(t0)
                except (ValueError, OverflowError):
                    continue
                if mode != "implement" or workdir not in workdirs or not recent:
                    continue
                parsed = SHADOW_PAIR.fullmatch(pair)
                if not parsed:
                    continue
                kept.append((*parsed.groups(), "+fast-mode" in line[match.start(3):match.start(5)],
                             fallback, int(rc)))
    except (OSError, ValueError):
        pass
    n = len(kept)
    record["attempts"] = n
    if n:
        legal_retry = (n == 2 and kept[0][0] == "gpt-6-astra" and kept[0][4] != 0
                       and kept[0][3] is None and kept[1][3] == "gpt-6-astra")
        record["observation"] = "exact" if not truncated and (n == 1 or legal_retry) else "ambiguous"
        (record["final_model"], record["final_effort"], record["final_fast_mode"],
         record["final_fallback_from"], record["codex_exit"]) = kept[-1]
    session = shadow_session(flags["--task-dir"], record["lane"])
    if session is not None and session != snapshot:
        parts = session.split("|")
        if re.fullmatch(r"[0-9a-f-]{36}", parts[0]):
            record["thread_id"] = parts[0]
        if n and len(parts) >= 3 and tuple(parts[1:3]) != (record["final_model"], record["final_effort"]):
            record["observation"] = "ambiguous"


def shadow_decide(policy, record, flags):
    if policy["SHADOW_ENABLED"] != "1" or policy["ENABLED"] != "1":
        return "unavailable:disabled"
    if os.environ.get("CC_ORCH_BACKEND") == "codex":
        return "unavailable:codex-only backend"
    if not policy.valid():
        return "unavailable:config"
    stdout = sys.stdout
    try:
        sys.stdout = io.StringIO()
        key = read_key()
    finally:
        sys.stdout = stdout
    if not key:
        return "unavailable:no key"
    choice, noul = load_template("difficulty"), load_template("difficulty-reasoning")
    if choice is None or noul is None:
        return "unavailable:template"
    try:
        # O_NONBLOCK lets fstat reject FIFOs without waiting for a writer.
        fd = os.open(os.path.join(flags["--task-dir"], "brief.md"),
                     os.O_RDONLY | os.O_NOFOLLOW | os.O_NOCTTY | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                return "skipped:unreadable"
            raw = stream.read().decode("utf-8", errors="replace")
    except (OSError, ValueError):
        return "skipped:unreadable"
    if secret_shaped(raw):
        return "skipped:secret-shaped"
    text = risk_state(raw).strip()
    if not text:
        return "skipped:empty"
    data, cap = text.encode(), policy["SHADOW_MAX_BYTES"]
    if len(data) > cap:
        text = data[:cap].decode("utf-8", errors="ignore")
        text = text.rsplit("\n", 1)[0] if "\n" in text else text
        record["truncated"] = True
    questions = {"difficulty": choice, "reasoning": noul}
    if (any(secret_shaped(value) for value in state_strings(questions))
            or secret_shaped(json.dumps(questions, ensure_ascii=False))
            or any(secret_shaped(value) for value in state_strings(text))
            or secret_shaped(json.dumps(text, ensure_ascii=False))):
        return "skipped:secret-shaped"
    start = time.monotonic()
    outcome, payload = call_jev(policy, key, text, questions)
    record.update(jev_attempts=policy.attempts, jev_latency_ms=int((time.monotonic() - start) * 1000))
    if outcome != "ok":
        return "unavailable:" + outcome
    answers = payload["answers"]
    record.update(difficulty=answers["difficulty"]["choice"],
                  difficulty_confidence=answers["difficulty"]["confidence"],
                  reasoning=answers["reasoning"]["noul"], jev_model=policy.model)
    usage = payload.get("usage")
    tokens = usage.get("input_tokens") if isinstance(usage, dict) else None
    record["input_tokens"] = tokens if type(tokens) is int else None
    return "ok"


def shadow_main(args):
    try:
        flags = shadow_flags(args, {"--mode": "implement", "--lane": "implement", "--workdir": "",
            "--task-dir": "", "--pid": "0", "--t0": "", "--skip": "-", "--initial": "",
            "--pressure": "", "--fast-mode": "0", "--explicit": "0"})
    except ValueError:
        print("usage: orch-jev shadow <flags>", file=sys.stderr)
        return 2
    policy, record = None, None
    try:
        try:
            os.setsid()
        except OSError:
            pass
        try:
            log_offset = (state_dir() / "codex.log").stat().st_size
        except OSError:
            log_offset = 0
        policy = Policy()
        valid_mode = flags["--mode"] in ("implement", "resume")
        valid_pid = re.fullmatch(r"[0-9]+", flags["--pid"]) is not None
        invalid_args = not (re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,31}", flags["--lane"])
                            and valid_mode and valid_pid
                            and flags["--skip"] in ("-", "resume", "dry-run", "explicit-flags", "no-route", "withheld")
                            and flags["--fast-mode"] in ("0", "1") and flags["--explicit"] in ("0", "1"))
        if invalid_args:
            flags["--lane"] = "invalid"
        # Missing paths skip the worker without discarding an otherwise valid lane.
        invalid_args = invalid_args or not flags["--task-dir"] or not flags["--workdir"]
        if not valid_mode:
            flags["--mode"] = "invalid"
        if not valid_pid:
            flags["--pid"] = "0"
        pressure = flags["--pressure"] if re.fullmatch(r"[a-z-]{1,20}", flags["--pressure"]) else None
        try:
            t0 = float(flags["--t0"])
            if not math.isfinite(t0):
                t0 = time.time()
        except ValueError:
            t0 = time.time()
        record = dict.fromkeys(SHADOW_KEYS)
        record.update(timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),
                      id=f"{flags['--lane']}:{flags['--pid']}:{int(t0)}", lane=flags["--lane"],
                      mode=flags["--mode"], status="unavailable:internal error", suggested_reason="no-answer",
                      attempts=0, observation="none", explicit_flags=flags["--explicit"] == "1",
                      pressure=pressure, jev_attempts=0, truncated=False)
        initial = SHADOW_PAIR.fullmatch(flags["--initial"])
        if initial:
            record.update(initial_model=initial[1], initial_effort=initial[2],
                          initial_fast_mode=flags["--fast-mode"] == "1")
        signal.signal(signal.SIGALRM, lambda signum, frame: shadow_deadline(record, policy))
        signal.alarm(int(policy["SHADOW_TIMEOUT_SECONDS"]) + 2 * int(policy.timeout) + 30)
        snapshot = (shadow_session(flags["--task-dir"], flags["--lane"])
                    if not invalid_args and flags["--skip"] == "-" else None)
        if invalid_args:
            record["status"] = "skipped:invalid-args"
        elif flags["--skip"] != "-":
            record["status"] = "skipped:" + flags["--skip"]
        else:
            record["status"] = shadow_decide(policy, record, flags)
            (record["suggested_model"], record["suggested_effort"], record["suggested_reason"]) = map_difficulty(
                policy, record["difficulty"], record["difficulty_confidence"])
            shadow_observe(policy, record, flags, t0, snapshot, log_offset)
    except Exception:
        if record is not None:
            record["status"] = "unavailable:internal error"
    finally:
        if record is not None:
            written = append_shadow(policy, record)
            if record["status"] != "ok" or not written:
                diagnose(record["id"], record["status"] + ("" if written else " (log write failed)"))
        signal.alarm(0)
    return 0


def shadow_report_main(args):
    try:
        flags = shadow_flags(args, {"--log": ""})
    except ValueError:
        print("usage: orch-jev shadow-report [--log <path>]", file=sys.stderr)
        return 2
    try:
        policy = Policy()
        path = Path(flags["--log"]) if flags["--log"] else shadow_log_path(policy)
        records, malformed = [], 0
        try:
            with path.open(encoding="utf-8", errors="replace") as stream:
                for line in stream:
                    try:
                        record = json.loads(line)
                        if (not isinstance(record, dict) or set(record) != set(SHADOW_KEYS)
                                or any(type(record[name]) not in types for name, types in SHADOW_TYPES.items())):
                            raise ValueError
                        records.append(record)
                    except (ValueError, RecursionError):
                        malformed += 1
        except OSError:
            pass
        statuses, buckets = {}, {}
        comparable = agreement = lower = higher = unranked = differing = 0
        for record in records:
            status = str(record["status"])
            statuses[status] = statuses.get(status, 0) + 1
            model, effort, _ = map_difficulty(policy, record["difficulty"], record["difficulty_confidence"])
            suggested = (model, effort)
            final = (record["final_model"], record["final_effort"])
            differing += suggested != (record["suggested_model"], record["suggested_effort"])
            tier = record["difficulty"] if model else "none"
            bucket = buckets.setdefault(tier, [0, 0, 0, 0])
            bucket[0] += 1
            if (record["observation"] == "exact" and type(record["codex_exit"]) is int
                    and type(record["attempts"]) is int):
                bucket[1] += 1
                bucket[2] += record["codex_exit"] != 0
                bucket[3] += record["attempts"] > 1
            if record["observation"] != "exact" or not all(suggested + final):
                continue
            comparable += 1
            if any(pair[0] not in MODEL_RANK or pair[1] not in EFFORT_RANK for pair in (suggested, final)):
                unranked += 1
            elif suggested == final:
                agreement += 1
            else:
                rank = lambda pair: (EFFORT_RANK[pair[1]], MODEL_RANK[pair[0]])
                lower += rank(suggested) < rank(final)
                higher += rank(suggested) > rank(final)
                # Distinct Sol/Terra pairs (either generation) have equal ranks, but are not agreements.
                unranked += rank(suggested) == rank(final)
        def percentage(n, total):
            return f"{100 * n / total:.1f}%" if total else "n/a"
        print(f"JEV shadow report — {path}")
        print(f"records: {len(records)}  malformed: {malformed}")
        print("status: " + " · ".join(f"{status} {n}" for status, n in sorted(statuses.items())))
        print(f"comparable (exact observation, suggestion and final pair known): {comparable}")
        print(f"  agreement (suggested == final): {agreement} ({percentage(agreement, comparable)})")
        print(f"  suggested lower than final:     {lower} ({percentage(lower, comparable)})")
        print(f"  suggested higher than final:    {higher} ({percentage(higher, comparable)})")
        print(f"  unranked pair:                  {unranked}")
        print("per suggested tier (re-mapped with the current jev-policy.conf):")
        for tier in (*DIFFICULTIES, "none"):
            if tier not in buckets:
                continue
            n, observed, failures, retries = buckets[tier]
            small = " — fewer than 10 records" if n < 10 else ""
            if observed < 10:
                small += " — fewer than 10 observed"
            print(f"  {tier}: {n} records · observed (exact, exit known): {observed} · unobserved: {n - observed}"
                  f" · codex failures (exit != 0): {failures}/{observed} ({percentage(failures, observed)})"
                  f" · retries (attempts > 1): {retries}/{observed} ({percentage(retries, observed)}){small}")
        print(f"stored suggestions differing from the current mapping: {differing}")
        print("counts only — this report draws no conclusion.")
    except Exception as error:
        print(f"shadow-report: failed ({type(error).__name__})", file=sys.stderr)
        return 0
    return 0


def local_second_opinion(policy, state, questions, outcome, payload):
    # Opt-in, log-only local scan second opinion (bin/orch-jev-local). Never prints, never waits,
    # never changes this command's output or exit status; any failure is swallowed.
    if policy["LOCAL_ENABLED"] != "1":
        return
    try:
        jev = None
        if outcome == "ok":
            jev = {name: payload["answers"][name]["noul"] for name in questions}
        handoff = {"version": 1, "pid": os.getpid(), "t0": time.time(), "state": state,
                   "questions": questions, "jev_model": policy.model, "jev_outcome": outcome,
                   "jev_noul": jev}
        env = {name: value for name, value in os.environ.items() if name != "TYPESAFE_API_KEY"}
        with tempfile.TemporaryFile() as stream, warnings.catch_warnings():
            # Never waited on: finalize the Popen here, where its "still running"
            # ResourceWarning cannot reach this command's stderr (gate r1 finding 1).
            warnings.simplefilter("ignore", ResourceWarning)
            stream.write(json.dumps(handoff, ensure_ascii=False).encode())
            stream.seek(0)
            worker = subprocess.Popen([sys.executable, "-B", str(REPO_DIR / "bin/orch-jev-local"), "worker"],
                                      stdin=stream, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                      close_fds=True, start_new_session=True, env=env)
            del worker
    except Exception:
        pass


def main(argv) -> int:
    if argv and argv[0] == "shadow":
        return shadow_main(argv[1:])
    if argv and argv[0] == "shadow-report":
        return shadow_report_main(argv[1:])
    help_requested = len(argv) == 1 and argv[0] in ("--help", "-h", "help")
    valid_args = bool(argv and argv[0] in ("lint-brief", "risk", "scan") and len(argv) >= 2
                      and (argv[0] == "scan" or len(argv) == 2))
    command = "help" if help_requested else argv[0] if valid_args else "usage"
    policy = None
    record = dict(timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(), subcommand=command,
                  outcome="ok", attempts=0, latency_ms=None, model=DEFAULTS["JEV_MODEL"], questions=0,
                  input_tokens=None, output_tokens=None)
    try:
        policy = Policy()
        record["model"] = policy.model
        if help_requested:
            for line in (USAGE, "key sources: TYPESAFE_API_KEY or <state>/jev.key (mode 600)",
                         "lines: lint, risk, scan, note, warning, skipped, unavailable",
                         "advisory only; exit 0 on every outcome except usage errors", "not used in Codex-only mode",
                         "shadow: detached log-only Codex-routing worker started by codex-run-runtime; shadow-report prints counts"):
                emit("JEV: " + line)
            return 0
        if not valid_args:
            print(USAGE, file=sys.stderr)
            return 2
        unavailable = ("disabled" if policy["ENABLED"] != "1" else
                       "codex-only backend" if os.environ.get("CC_ORCH_BACKEND") == "codex" else
                       "config" if not policy.valid() else None)
        if unavailable is None:
            key = read_key()
            unavailable = None if key else "no key"
        if unavailable is None:
            template = load_template(command)
            unavailable = None if template is not None else "template"
        if unavailable is None:
            state, questions, declared, skipped, chunk_sources = prepare(command, argv[1:], policy, template)
            if state is None:
                record["outcome"] = "skipped:" + skipped
                return 0
            record["questions"] = len(questions)
            start = time.monotonic()
            if (any(secret_shaped(text) for text in state_strings(questions))
                    or secret_shaped(json.dumps(questions, ensure_ascii=False))
                    or any(secret_shaped(text) for text in state_strings(state))
                    or secret_shaped(json.dumps(state, ensure_ascii=False))):
                record["outcome"] = "skipped:secret-shaped"
                emit("JEV: skipped — secret-shaped literal (after transformation)")
                return 0
            outcome, payload = call_jev(policy, key, state, questions)
            record.update(attempts=policy.attempts, latency_ms=int((time.monotonic() - start) * 1000))
            if outcome == "ok":
                usage = payload.get("usage")
                for field in ("input_tokens", "output_tokens"):
                    value = usage.get(field) if isinstance(usage, dict) else None
                    record[field] = value if type(value) is int else None
                results(command, state, payload["answers"], declared, policy, chunk_sources)
            else:
                unavailable = outcome
            if command == "scan":
                local_second_opinion(policy, state, questions, outcome, payload)
        if unavailable is not None:
            record["outcome"] = "disabled" if unavailable == "disabled" else "unavailable:" + unavailable
            emit("JEV: unavailable — " + unavailable)
        return 0
    except Exception:
        record["outcome"] = "unavailable:internal error"
        emit("JEV: unavailable — internal error")
        return 0
    finally:
        if valid_args and (policy is None or policy["JOURNAL"] != "0"):
            journal(record)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
