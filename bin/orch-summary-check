#!/usr/bin/env bash
# Validate task artifacts against the model/dispatch/context policy.
set -uo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=/dev/null
. "$REPO_DIR/model-policy.conf"

STRICT=0
if [ "${1:-}" = "--strict" ]; then STRICT=1; shift; fi
TASK_DIR="${1:-}"
if [ -z "$TASK_DIR" ] || [ ! -d "$TASK_DIR" ]; then
  echo "usage: orch-summary-check [--strict] <task-dir>" >&2
  exit 2
fi
TASK_DIR="$(cd "$TASK_DIR" && pwd)"

errors=0 warnings=0
problem() { # problem error|warning <message>
  if [ "$1" = "error" ] || [ "$STRICT" = "1" ]; then
    echo "ERROR: $2"; errors=$((errors + 1))
  else
    echo "WARN:  $2"; warnings=$((warnings + 1))
  fi
}

check_size() { # file limit
  local file="$1" limit="$2" size
  [ -f "$file" ] || return 0
  size="$(wc -c < "$file")"
  [ "$size" -le "$limit" ] || problem warning "$(basename "$file") is ${size}B (budget ${limit}B); move detail to evidence/ or rounds/"
}

# Remove fenced blocks with delimiter- and run-length-faithful tracking: only the same character, a run at least as long, and no trailing content closes; a file containing NUL bytes yields no output and exit 1 so callers fail closed.
strip_fences() { # file -> stdout without fenced blocks
  if ! tr -d '\000' < "$1" | cmp -s - "$1"; then return 1; fi
  awk '
    {
      if (match($0, /^[[:space:]]*(```+|~~~+)/)) {
        run = substr($0, RSTART, RLENGTH); sub(/^[[:space:]]*/, "", run)
        ch = substr(run, 1, 1); len = length(run)
        if (fence == "") { fence = ch; flen = len; next }
        if (ch == fence && len >= flen && substr($0, RSTART + RLENGTH) ~ /^[[:space:]]*$/) { fence = ""; next }
      }
      if (fence == "") print
    }' "$1"
}

BRIEF="$TASK_DIR/brief.md"; PLAN="$TASK_DIR/plan.md"; SUMMARY="$TASK_DIR/summary.md"
check_size "$BRIEF" "$BRIEF_MAX_BYTES"
check_size "$PLAN" "$PLAN_MAX_BYTES"
check_size "$SUMMARY" "$SUMMARY_MAX_BYTES"

[ -r "$BRIEF" ] || problem error "missing brief.md"
[ -r "$PLAN" ] || problem error "missing plan.md"
[ -r "$SUMMARY" ] || problem error "missing summary.md"

risk=""
if [ -r "$BRIEF" ]; then
  # Strip fenced examples before any tier selection, counting, or conflict detection. Prefer a
  # declaration-shaped line; only briefs with no raw declaration keep the legacy prose scan.
  if ! nofence="$(strip_fences "$BRIEF")"; then problem error "brief.md contains NUL bytes"; fi
  anchor='^[[:space:]]*(-[[:space:]]*)?RISK:'
  anchored="$(printf '%s\n' "$nofence" | grep -E "$anchor")"
  if [ -n "$anchored" ]; then
    risk_line="$(printf '%s\n' "$anchored" | head -1)"
    anchored_count="$(printf '%s\n' "$nofence" | grep -cE "$anchor")"
    parsed="$(printf '%s\n' "$risk_line" | sed -n 's/^[[:space:]]*\(-[[:space:]]*\)\{0,1\}RISK:[[:space:]]*\*\{0,2\}\([a-z]*\).*/\2/p')"
    tiers="$(printf '%s\n' "$anchored" | sed -n 's/^[[:space:]]*\(-[[:space:]]*\)\{0,1\}RISK:[[:space:]]*\*\{0,2\}\([a-z]*\).*/\2/p')"
    # Differing valid declaration tiers always conflict; same-value non-trivial duplicates retain
    # first-line semantics. Trivial remains stricter about any duplicate declaration.
    if printf '%s\n' "$parsed" | grep -xE 'trivial|low|normal|critical' >/dev/null && printf '%s\n' "$tiers" | grep -vxF "$parsed" | grep -xE 'trivial|low|normal|critical' >/dev/null; then
      parsed="conflicting-$parsed"
    # The gate-skipping tier must stand alone on its line, optionally followed by a dash-led
    # reason; "RISK: trivial | low | normal | critical" or "RISK: trivial/critical" is malformed,
    # not trivial. Only trivial gets this rule; low/normal/critical parsing stays unchanged.
    elif [ "$parsed" = "trivial" ] && [ "$anchored_count" -gt 1 ]; then
      parsed="ambiguous-trivial"
    elif [ "$parsed" = "trivial" ]; then
      # The gate-skipping declaration must be column-0, unique, and stand-alone.
      if [ "$(printf '%s\n' "$nofence" | grep -c '^RISK:')" != 1 ]; then
        parsed="undeclared-trivial"
      elif ! printf '%s\n' "$nofence" | grep -qE '^RISK:[[:space:]]*\*{0,2}trivial\*{0,2}($|[[:space:]]+(—|–|-))'; then
        parsed="malformed-trivial"
      fi
    fi
  else
    if grep -qE "$anchor" "$BRIEF"; then
      # Every declaration-shaped line is fenced: fail closed, preserving the trivial diagnostic.
      parsed=""
      if grep -E "$anchor" "$BRIEF" | sed -n 's/^[[:space:]]*\(-[[:space:]]*\)\{0,1\}RISK:[[:space:]]*\*\{0,2\}\([a-z]*\).*/\2/p' | grep -x 'trivial' >/dev/null; then
        parsed="undeclared-trivial"
      fi
    else
      parsed="$(printf '%s\n' "$nofence" | sed -n 's/.*RISK:[[:space:]]*\*\{0,2\}\([a-z]*\).*/\1/p' | head -1)"
      [ "$parsed" = "trivial" ] && parsed="unanchored-trivial"
    fi
  fi
  [ -n "$parsed" ] && risk="$parsed"
fi
case "$risk" in trivial|low|normal|critical) ;; *) problem error "invalid or missing RISK (got '${risk:-empty}')"; risk="normal" ;; esac

# A lead may downgrade only low -> trivial, recorded as a line of its own in plan.md; fenced
# examples are ignored. The downgrade must be reported as BRIEF AUDIT: amended. Nothing else may move.
amended=""
downgraded=0
if [ -r "$PLAN" ]; then
  if ! plan_nofence="$(strip_fences "$PLAN")"; then problem error "plan.md contains NUL bytes"; fi
  amended_count="$(printf '%s\n' "$plan_nofence" | grep -cE '^RISK AMENDED:')"
  if [ "$amended_count" -gt 1 ]; then
    problem error "plan.md must contain at most one RISK AMENDED line (found $amended_count)"
  elif [ "$amended_count" = 1 ]; then
    amended="$(printf '%s\n' "$plan_nofence" | sed -n 's/^RISK AMENDED:[[:space:]]*\([a-z]*\)[[:space:]]*\(->\|→\)[[:space:]]*\([a-z]*\)\([[:space:]].*\)\{0,1\}$/\1 \3/p' | head -1)"
    printf '%s\n' "$amended" | grep -qE '^[a-z]+ [a-z]+$' || amended=""
    if [ "$amended" = "low trivial" ] && [ "$risk" = "low" ]; then
      risk="trivial"
      downgraded=1
      echo "NOTE:  RISK low downgraded to trivial by plan.md 'RISK AMENDED: low -> trivial'"
    else
      problem error "RISK AMENDED may only downgrade low -> trivial (brief risk '$risk', got '${amended:-malformed}')"
    fi
  fi
fi

if [ -r "$SUMMARY" ]; then
  backend="$(sed -n 's/^BACKEND:[[:space:]]*//p' "$SUMMARY" | tail -1)"
  if [ "$backend" = codex ]; then
    grep -q '^CODEX PROFILE:' "$SUMMARY" || problem warning "summary lacks CODEX PROFILE"
  else
    grep -q '^CLAUDE PROFILE:' "$SUMMARY" || problem warning "summary lacks CLAUDE PROFILE"
  fi
  grep -q '^PROMOTIONS:' "$SUMMARY" || problem warning "summary lacks PROMOTIONS"
  grep -q '^DISPATCH: codex-\(first\|sparing\)' "$SUMMARY" || problem warning "DISPATCH must be codex-first or codex-sparing"
  grep -q '^INVESTIGATION:' "$SUMMARY" || problem warning "summary lacks INVESTIGATION"
  grep -q '^LANES:' "$SUMMARY" || problem warning "summary lacks LANES"

  gates="$(grep '^GATES:' "$SUMMARY" | tail -1)"
  if [ -z "$gates" ]; then
    problem error "summary lacks GATES"
  else
    if [ "$risk" = "trivial" ]; then
      # trivial skips Tier 4 by policy; the line must still open with the lead's own self-check
      # record and say what was checked. Extra evidence may follow, but never replace it.
      desc="$(printf '%s' "$gates" | sed -n 's/^GATES:[[:space:]]*self-check only (trivial)//p' | sed 's/^[[:space:]—–:-]*//')"
      # Every documented trivial GATES form names a command, file, or number, so require at least
      # one ASCII letter/digit; this is locale-independent and rejects emoji/punctuation-only text.
      printf '%s' "$desc" | grep -q '[A-Za-z0-9]' || problem error "trivial risk must report 'GATES: self-check only (trivial) — <what was checked>'"
    else
      codex_verify_ok=0; codex_review_ok=0; claude_verify_ok=0
      printf '%s' "$gates" | grep -qiE 'codex-verify[[:space:]]+PASS' && codex_verify_ok=1
      printf '%s' "$gates" | grep -qiE 'codex-review[[:space:]]+(CLEAR|NONBLOCKING)' && codex_review_ok=1
      printf '%s' "$gates" | grep -qiE 'claude-verifier[[:space:]]+PASS' && claude_verify_ok=1

      # A provider outage may fall back to the zero-context Claude verifier, but it must be
      # visible in the same line; a bare missing/waived executable verdict is never PASS.
      if [ "$backend" = codex ]; then
        [ "$codex_verify_ok" = 1 ] || problem error "Codex-only executable verification must PASS"
        [ "$codex_review_ok" = 1 ] || problem error "Codex-only review must be CLEAR/NONBLOCKING"
        if [ "$risk" = critical ]; then
          printf '%s' "$gates" | grep -qiE 'codex-auditor[[:space:]]+PASS' || problem error "critical Codex-only risk requires codex-auditor PASS"
        fi
      elif [ "$codex_verify_ok" = "0" ]; then
        if ! printf '%s' "$gates" | grep -qiE 'codex-verify[[:space:]]+unavailable' || \
           [ "$claude_verify_ok" = "0" ]; then
          problem error "executable verification did not PASS and has no explicit Claude fallback"
        fi
      fi
      if [ "$backend" != codex ] && [ "$codex_review_ok" = "0" ]; then
        if [ "$risk" = "low" ] && printf '%s' "$gates" | grep -qiE 'codex-review[[:space:]]+waived'; then
          :
        elif printf '%s' "$gates" | grep -qiE 'codex-review[[:space:]]+unavailable' && \
             [ "$claude_verify_ok" = "1" ]; then
          :
        else
          problem error "adversarial review is not CLEAR/NONBLOCKING (only low risk may waive it)"
        fi
      fi
      if [ "$backend" != codex ] && [ "$risk" = "critical" ] && [ "$claude_verify_ok" = "0" ]; then
        problem error "critical risk requires claude-verifier PASS"
      fi
    fi
  fi

  lane_line="$(grep '^LANES:' "$SUMMARY" | tail -1)"
  if printf '%s' "$lane_line" | grep -qE 'dev-(opus-)?[123]'; then
    printf '%s' "$lane_line" | grep -qiE 'exception:[[:space:]]*(fallback|context|steering|gpu|fresh-eyes|sparing)' \
      || problem error "Claude dev lane lacks an allowed exception tag"
  fi

  rounds="$(sed -n 's/^ROUNDS:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$SUMMARY" | tail -1)"
  if [ -n "$rounds" ]; then
    [ "$rounds" -ge 1 ] || problem error "ROUNDS must be at least 1"
    # trivial and low share the normal cap.
    cap="$NORMAL_GATE_ROUNDS"; [ "$risk" = "critical" ] && cap="$CRITICAL_GATE_ROUNDS"
    if [ "$rounds" -gt "$cap" ] && ! grep -qi '^EXTRA GATE ROUND:[[:space:]]*approved' "$BRIEF"; then
      problem error "ROUNDS=$rounds exceeds $risk cap=$cap without EXTRA GATE ROUND: approved"
    fi
  else
    problem warning "summary lacks numeric ROUNDS"
  fi

  profile="$(sed -n 's/^CLAUDE PROFILE:[[:space:]]*//p' "$SUMMARY" | tail -1)"
  if [ "$backend" = codex ]; then
    profile="$(sed -n 's/^CODEX PROFILE:[[:space:]]*//p' "$SUMMARY" | tail -1)"
  fi
  case "$risk" in
    low)      printf '%s' "$profile" | grep -qi 'light\|sonnet\|fallback.*opus' || problem warning "low risk should use light/Sonnet or recorded Opus fallback" ;;
    trivial)  printf '%s' "$profile" | grep -qi 'light\|sonnet\|fallback.*opus' || problem warning "trivial risk should use light/Sonnet or recorded Opus fallback" ;;
    normal)   printf '%s' "$profile" | grep -qi 'normal\|opus\|fallback' || problem warning "normal risk should use the normal/Opus profile" ;;
    critical) printf '%s' "$profile" | grep -qi 'critical\|deep\|fable\|fallback.*opus' || problem warning "critical risk should use its critical/deep profile or recorded fallback" ;;
  esac

  if [ "$downgraded" = 1 ]; then
    grep -qiE '^BRIEF AUDIT:[[:space:]]*amended' "$SUMMARY" || problem error "low -> trivial downgrade must be reported as BRIEF AUDIT: amended"
  fi

  if grep -qi '^PROMOTIONS:.*fable' "$SUMMARY" && ! grep -qi '^PROMOTIONS:.*\(critical\|user\|failed\|security\|algorithm\)' "$SUMMARY"; then
    problem warning "Fable promotion lacks a critical/user/failure reason"
  fi
fi

# Independent advisory scan: its output and status never feed the gate counters.
if [ -x "$REPO_DIR/bin/orch-security-scan" ]; then
  echo '--- advisory security scan ---'
  security_status=0
  # The installed tool can live in an unrelated checkout. Prefer the caller's
  # worktree (task artifacts can be shared from the orchestrator's checkout).
  security_repo="$(git rev-parse --show-toplevel 2>/dev/null)" || security_repo=""
  if [ -z "$security_repo" ]; then
    security_repo="$(git -C "$TASK_DIR" rev-parse --show-toplevel 2>/dev/null)" || security_repo=""
  fi
  security_output="$("$REPO_DIR/bin/orch-security-scan" "${security_repo:-$TASK_DIR}")" || security_status=$?
  [ -z "$security_output" ] || printf '%s\n' "$security_output"
  security_count="$(printf '%s\n' "$security_output" | grep -c '^SECWARN:' || true)"
  if [ "$security_count" -gt 0 ]; then
    echo "SECURITY: $security_count advisory warning(s) — informational only, does not affect PASS/FAIL/error-count"
  elif [ "$security_status" -ne 0 ] || [[ "$security_output" == *'SECURITY SCAN:'* ]]; then
    echo 'SECURITY: skipped or unavailable (advisory only)'
  else
    echo 'SECURITY: clean'
  fi
fi

if [ "$errors" -gt 0 ]; then
  echo "CHECK: FAIL ($errors error(s), $warnings warning(s))"
  exit 1
fi
if [ "$warnings" -gt 0 ]; then
  echo "CHECK: WARN ($warnings warning(s))"
else
  echo "CHECK: PASS (risk=$risk)"
fi
