#!/usr/bin/env bash
# Explicit Codex-only launcher; does not consult or install Claude.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
if [ "${1:-}" = --backend ]; then
  exec "$REPO_DIR/bin/cc-orch-runtime" "$@"
fi
export CC_ORCH_BACKEND=codex
export CC_ORCH_STATE_DIR="${CC_ORCH_STATE_DIR:-$HOME/.local/state/cc-orchestra-codex}"
case "${1:-}" in
  session|sessions) shift; exec "$REPO_DIR/bin/cc-orch-session" "$@" ;;
  *) exec python3 "$REPO_DIR/lib/orch_codex.py" launch "$@" ;;
esac
