#!/usr/bin/env bash
# orch-doctor — detect missing, changed, or stale rendered agent profiles.
#
# usage:
#   orch-doctor [<manifest-path>]
#
# Reads the builders' NDJSON manifest without changing files or fetching from git.
# Exit 0: all entries OK; 1: an installation problem; 2: setup/input error.
set -uo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
AGENTS_DIR="${CC_ORCH_AGENTS_DIR:-$HOME/.claude/agents}"
MANIFEST="${CC_ORCH_MANIFEST:-$AGENTS_DIR/.install-manifest.json}"

case "${1:-}" in
  -h|--help) echo 'usage: orch-doctor [<manifest-path>]'; exit 0 ;;
  -*) echo 'usage: orch-doctor [<manifest-path>]' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo 'usage: orch-doctor [<manifest-path>]' >&2; exit 2; }
[[ $# -eq 0 ]] || MANIFEST="$1"
[[ -f "$MANIFEST" && -r "$MANIFEST" ]] || {
  echo "ERROR: manifest not found or unreadable: $MANIFEST — run build-roster-runtime.sh" >&2
  exit 2
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum < "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 < "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 < "$1" | awk '{print $NF}'
  else
    echo "ERROR: SHA-256 requires sha256sum, shasum, or openssl" >&2
    return 1
  fi
}

json_field() { # json_field <line> <key>; the writer escapes only quotes and backslashes.
  local pattern='"'"$2"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\["\\])*)"' value
  [[ "$1" =~ $pattern ]] || return 1
  value="${BASH_REMATCH[1]}"
  value="${value//\\\"/\"}"
  value="${value//\\\\/\\}"
  printf '%s' "$value"
}

CURRENT_COMMIT="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo unknown)"
total=0; ok=0; missing=0; drifted=0; stale=0; mismatch=0
while IFS= read -r line || [[ -n "$line" ]]; do
  total=$((total + 1))
  if ! dest="$(json_field "$line" dest)" || [[ -z "$dest" ]] ||
     ! template="$(json_field "$line" template)" || [[ -z "$template" ]] ||
     ! recorded_sha="$(json_field "$line" sha256)" || [[ ! "$recorded_sha" =~ ^[[:xdigit:]]{64}$ ]] ||
     ! template_sha="$(json_field "$line" template_sha256)" || [[ ! "$template_sha" =~ ^[[:xdigit:]]{64}$ ]] ||
     ! commit="$(json_field "$line" commit)" || [[ -z "$commit" ]]; then
    echo "ERROR: invalid manifest entry at $MANIFEST:$total" >&2
    exit 2
  fi

  if [[ ! -e "$dest" ]]; then
    status=MISSING; missing=$((missing + 1))
  else
    current_sha="$(sha256_of "$dest")" || exit 2
    if [[ "$current_sha" != "$recorded_sha" ]]; then
      status=DRIFTED; drifted=$((drifted + 1))
    else
      current_template_sha=""
      if [[ -f "$REPO_DIR/$template" ]]; then
        current_template_sha="$(sha256_of "$REPO_DIR/$template")" || exit 2
      fi
      if [[ "$current_template_sha" != "$template_sha" ]]; then
        status=STALE-TEMPLATE; stale=$((stale + 1))
      elif [[ "$commit" != "$CURRENT_COMMIT" ]]; then
        status=REPO-VERSION-MISMATCH; mismatch=$((mismatch + 1))
      else
        status=OK; ok=$((ok + 1))
      fi
    fi
  fi
  printf '%s %s\n' "$status" "$dest"
done < "$MANIFEST"

[[ "$total" -gt 0 ]] || { echo "ERROR: empty manifest: $MANIFEST" >&2; exit 2; }
printf 'SUMMARY: %d entries, %d ok, %d missing, %d drifted, %d stale-template, %d repo-version-mismatch\n' \
  "$total" "$ok" "$missing" "$drifted" "$stale" "$mismatch"

# Only consult locally available tracking information; doctor must also work offline.
upstream_commit="$(git -C "$REPO_DIR" rev-parse '@{u}' 2>/dev/null || true)"
if [[ -n "$upstream_commit" && "$upstream_commit" != "$CURRENT_COMMIT" ]]; then
  upstream_ref="$(git -C "$REPO_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
  if apart="$(git -C "$REPO_DIR" rev-list --count "HEAD...$upstream_commit" 2>/dev/null)"; then
    printf 'NOTE: checkout HEAD differs from upstream %s (%s commit(s) apart) — run git pull\n' \
      "$upstream_ref" "$apart"
  fi
fi

[[ "$ok" -eq "$total" ]]
