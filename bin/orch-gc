#!/usr/bin/env python3
"""Report recoverable task checkouts; deletion is disabled in this release."""
import sys
sys.dont_write_bytecode = True
import argparse
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import time
import unicodedata

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import orch_archive

INACTIVE = {"PASS", "FAIL", "BLOCKED", "ACCEPTED", "CLOSED", "IDLE", "UNASSIGNED"}
TERMINAL = re.compile(r"(?:" + "|".join(sorted(INACTIVE)) + r")(?:[^A-Za-z0-9_-]|\Z)")
COMPLETE = re.compile(r"(?:ACCEPTED|CLOSED|PASS)(?:[^A-Za-z0-9_-]|\Z)")
SESSION_DAEMONS = {"(sd-pam)", "sshd", "ssh-agent", "gpg-agent", "fusermount", "fusermount3"}


class GitError(Exception):
    def __init__(self, message, returncode=None):
        super().__init__(message)
        self.returncode = returncode


def git(target, *args, common=False, allowed=(0,)):
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    # An empty allow-list overrides protocol.*.allow and blocks every lazy-fetch transport even without GIT_NO_LAZY_FETCH.
    env.update(GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", GIT_NO_LAZY_FETCH="1",
               GIT_ALLOW_PROTOCOL="", GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1", LC_ALL="C")
    argv = ["git"] + (["--git-dir=" + target] if common else ["-C", target])
    argv += ["-c", "core.fsmonitor=false", "-c", "protocol.allow=never", *args]
    try:
        result = subprocess.run(argv, env=env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise GitError(str(error)) from error
    output = result.stdout.decode("utf-8", "surrogateescape")
    if result.returncode not in allowed:
        raise GitError(result.stderr.decode("utf-8", "replace").strip() or
                       f"{args[0]} exited {result.returncode}", result.returncode)
    return output


def partial_clone(target, common=False):
    return git(target, "config", "--get-regexp", r"^(extensions\.partialclone|remote\..*\.promisor)$",
               common=common, allowed=(0, 1)).split("\n")[0]


def under(path, root):
    return path == root or path.startswith(root.rstrip(os.sep) + os.sep)


def real_dir(path):
    return not os.path.islink(path) and os.path.isdir(path)


def contained(path, item):
    if (not os.path.isabs(path) or any(p in (".", "..") for p in path.split(os.sep))
            or not real_dir(path) or os.path.dirname(path) != item.root):
        return False
    rel = os.path.relpath(path, item.top)
    return (not rel.startswith("..") and rel != "."
            and os.path.realpath(path) == os.path.join(os.path.realpath(item.top), rel))


class Item:
    def __init__(self, id, path, root, top=None):
        self.id, self.path, self.root, self.top = id, path, root, top or root
        self.backup = os.path.basename(path).startswith("archive-tmp")
        self.kind = "backup" if self.backup else "directory"
        self.bytes, self.age_days, self.archive = 0, 0, "-"
        self.branch, self.common_dir, self.reasons = "", "", []

    def add(self, severity, text):
        reason = {"severity": severity, "text": text}
        if reason not in self.reasons:
            self.reasons.append(reason)

    @property
    def classification(self):
        for severity in ("DANGER", "CAUTION"):
            if any(r["severity"] == severity for r in self.reasons):
                return severity
        return "SAFE"

    def reason(self):
        reasons = [r["text"] for r in self.reasons if r["severity"] == self.classification]
        return (reasons[0] if reasons else "") + (f" (+{len(self.reasons) - 1} more)"
                                                  if len(self.reasons) > 1 else "")

    def record(self):
        return dict(id=self.id, **{"class": self.classification}, kind=self.kind,
                    path=self.path, root=self.root, bytes=self.bytes, age_days=self.age_days,
                    archive=self.archive, branch=self.branch, reasons=self.reasons)


def process_table():
    paths, incomplete = [], []
    try:
        pids = os.listdir("/proc")
    except OSError:
        return [], ["process scan incomplete"]
    for pid in pids:
        if not pid.isdigit():
            continue
        base = "/proc/" + pid
        comm = "unknown"
        for attempt in range(4):
            inspect = base
            try:
                if os.stat(base).st_uid != os.getuid():
                    break
                state = Path(base, "stat").read_bytes().rpartition(b") ")[2][:1]
                if not state:
                    raise OSError("invalid process stat")
                if state in (b"Z", b"X"):
                    for tid in sorted(os.listdir(base + "/task")):
                        if tid == pid:
                            continue
                        thread = base + "/task/" + tid
                        try:
                            state = Path(thread, "stat").read_bytes().rpartition(b") ")[2][:1]
                        except FileNotFoundError:
                            continue
                        if state and state not in (b"Z", b"X"):
                            inspect = thread
                            break
                    else:
                        break
                comm = Path(inspect, "comm").read_text().strip()
                if (os.lstat(inspect + "/fd").st_uid != os.getuid()
                        or os.lstat(inspect + "/cwd").st_uid != os.getuid()):
                    if comm in SESSION_DAEMONS:
                        break
                    raise PermissionError("process entries not owned by current uid")
                links = [inspect + "/" + name for name in ("cwd", "exe", "root")]
                links += [inspect + "/fd/" + name for name in os.listdir(inspect + "/fd")]
                found = []
                for link in links:
                    try:
                        target = os.readlink(link)
                    except FileNotFoundError:
                        continue
                    if os.path.isabs(target) and not (link.endswith("/root") and target == "/"):
                        found.append((target, pid, comm))
                    if target.endswith(" (deleted)"):
                        stripped = target.removesuffix(" (deleted)")
                        if os.path.isabs(stripped):
                            found.append((stripped, pid, comm))
                for line in Path(inspect, "maps").read_bytes().decode("utf-8", "surrogateescape").split("\n"):
                    fields = line.split(None, 5)
                    if len(fields) == 6:
                        target = fields[5].replace(r"\012", "\n")
                        if os.path.isabs(target):
                            found.append((target, pid, comm))
                        if target.endswith(" (deleted)"):
                            stripped = target.removesuffix(" (deleted)")
                            if os.path.isabs(stripped):
                                found.append((stripped, pid, comm))
                paths.extend(found)
                break
            except (FileNotFoundError, ProcessLookupError):
                if inspect == base or not os.path.lexists(base):
                    break
                if attempt < 3:
                    time.sleep(0.05)
            except (OSError, UnicodeError):
                if attempt < 3:
                    time.sleep(0.05)
        else:
            incomplete.append(f"process scan incomplete: pid {pid} ({comm}) not inspectable")
    return paths, incomplete


def mount_table():
    try:
        points = []
        for line in Path("/proc/self/mountinfo").read_text().splitlines():
            value = line.split()[4]
            points.append(re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), value))
        return points, False
    except (OSError, UnicodeError, IndexError):
        return [], True


def worktrees(common):
    """Read registrations without line-oriented Git porcelain path parsing."""
    records, errors = [], []
    directory = os.path.join(common, "worktrees")
    try:
        names = sorted(os.listdir(directory))
    except FileNotFoundError:
        return [], [directory] if os.path.lexists(directory) else []
    except OSError:
        return [], [directory]
    for name in names:
        record = {"id": name}
        path = os.path.join(directory, name, "gitdir")
        try:
            target = Path(path).read_bytes().decode("utf-8", "surrogateescape").removesuffix("\n")
            if not target or not os.path.isabs(target) or "\0" in target:
                raise ValueError("invalid registered gitdir")
            record["worktree"] = os.path.dirname(target)
        except (OSError, ValueError):
            errors.append(path)
        records.append(record)
    return records, errors


class Context:
    def __init__(self, options):
        self.options, self.policy = options, orch_archive.load_policy()
        self.incomplete, self.sessions, self.rows = [], [], []
        self.bad_rows = []
        self.incomplete_by_top, self.item_common, self.borrowed_objects = {}, {}, set()
        self.items, self.roots, self.reference = [], {}, None
        self.partial = {}
        self.states = sorted({os.path.realpath(p) for p in
                              ([os.environ["CC_ORCH_STATE_DIR"]] if os.environ.get("CC_ORCH_STATE_DIR") else [])
                              + list(self.policy["STATE_DIRS"]) if os.path.isdir(p)})
        self.read_sessions()
        candidate = options.repo or os.path.realpath(os.path.expanduser("~/.claude/orchestra"))
        try:
            top = git(candidate, "rev-parse", "--show-toplevel").removesuffix("\n")
            common = git(candidate, "rev-parse", "--path-format=absolute", "--git-common-dir").removesuffix("\n")
            self.reference = {"top": os.path.realpath(top), "common": os.path.realpath(common)}
        except GitError:
            if options.repo or os.path.lexists(candidate):
                self.incomplete_at(candidate)
        self.discover()
        self.processes, self.proc_incomplete = process_table()
        self.mounts, self.mounts_incomplete = mount_table()
        self.read_registries()
        self.read_alternates()
        try:
            self.notes = set(os.listdir(self.policy["VAULT_DIR"] / "tasks"))
        except OSError:
            self.notes = set()

    def incomplete_at(self, path, top=None):
        message = f"activity records incomplete: {path}"
        messages = self.incomplete if top is None else self.incomplete_by_top.setdefault(top, [])
        if message not in messages:
            messages.append(message)

    def entries(self, path):
        try:
            with os.scandir(path) as entries:
                return sorted(entries, key=lambda e: e.name)
        except FileNotFoundError:
            return []
        except OSError:
            self.incomplete_at(path)
            return []

    def read_sessions(self):
        for state in self.states:
            for entry in self.entries(os.path.join(state, "sessions")):
                if not entry.name.endswith(".conf"):
                    continue
                values, errors = orch_archive.parse_conf(Path(entry.path))
                if values is None or errors:
                    self.incomplete_at(entry.path)
                for key in ("WORKDIR", "REPO"):
                    if values and values.get(key):
                        self.sessions.append((os.path.abspath(values[key]), entry.path, key))
            for entry in self.entries(os.path.join(state, "codex-projects")):
                path = os.path.join(entry.path, "project.json")
                try:
                    value = json.loads(Path(path).read_text())["directory"]
                    if not isinstance(value, str) or not value:
                        raise ValueError("invalid directory")
                    self.sessions.append((os.path.abspath(value), path, "directory"))
                except FileNotFoundError:
                    continue
                except (OSError, UnicodeError, ValueError, KeyError, TypeError):
                    self.incomplete_at(path)

    def add_root(self, path, prefix, backups=False):
        self.roots.setdefault(os.path.abspath(path), (prefix, backups))

    def discover(self):
        if self.options.root:
            for root in self.options.root:
                root = os.path.abspath(root)
                if not os.path.isdir(root):
                    raise ValueError(f"not a directory: {root}")
                self.add_root(root, os.path.basename(root))
        else:
            roots = [os.path.join(s, "worktrees") for s in self.states]
            if os.environ.get("CC_ORCH_WORKTREE_ROOT"):
                roots.append(os.environ["CC_ORCH_WORKTREE_ROOT"])
            for root in sorted(set(roots)):
                for entry in self.entries(root):
                    if real_dir(entry.path):
                        self.add_root(entry.path, entry.name)
            repos = [p for p, _, key in self.sessions if key == "REPO"]
            if self.reference:
                repos.append(self.reference["top"])
            for repo in repos:
                nested = os.path.join(repo, ".orchestra", "wt")
                if real_dir(os.path.dirname(nested)) and real_dir(nested):
                    self.add_root(nested, os.path.basename(repo) + "/.orchestra/wt")
            for base in self.policy["EXTRA_BASES"]:
                self.add_root(str(base), "backup", backups=True)
        used, seen = set(), set()

        def add(path, root, top, id):
            if path in seen:
                return
            seen.add(path)
            chosen = id
            if chosen in used:
                n = 2
                while id + f"~{n}" in used or id + f"~{n}" in reserved:
                    n += 1
                chosen = id + f"~{n}"
            used.add(chosen)
            item = Item(chosen, path, root, top)
            self.items.append(item)
            if contained(path, item):
                nested = os.path.join(path, ".orchestra", "wt")
                if real_dir(os.path.dirname(nested)) and real_dir(nested):
                    for child in self.entries(nested):
                        if child.is_symlink() or child.is_dir(follow_symlinks=False):
                            add(child.path, nested, top, item.id + "/.orchestra/wt/" + child.name)

        reserved = {prefix + "/" + entry.name for root, (prefix, backups) in self.roots.items()
                    for entry in self.entries(root)
                    if (not backups or entry.name.startswith("archive-tmp"))
                    and (entry.is_symlink() or entry.is_dir(follow_symlinks=False))}
        for root, (prefix, backups) in sorted(self.roots.items()):
            for entry in self.entries(root):
                if backups and not entry.name.startswith("archive-tmp"):
                    continue
                if entry.is_symlink() or entry.is_dir(follow_symlinks=False):
                    add(entry.path, root, root, prefix + "/" + entry.name)

    def read_registries(self):
        repos = {p for p, _, _ in self.sessions}
        for root in self.roots:
            ancestor = root
            while True:
                repos.add(ancestor)
                parent = os.path.dirname(ancestor)
                if parent == ancestor:
                    break
                ancestor = parent
        common_dirs = {}
        if self.reference:
            repos.add(self.reference["top"])
            common_dirs[self.reference["common"]] = {None}
        for item in self.items:
            if not contained(item.path, item):
                continue
            repos.add(item.path)
            dotgit = os.path.join(item.path, ".git")
            if os.path.lexists(dotgit):
                try:
                    common = os.path.realpath(git(item.path, "rev-parse", "--path-format=absolute",
                                                  "--git-common-dir").removesuffix("\n"))
                    self.item_common[item.path] = common
                    common_dirs.setdefault(common, set()).add(item.top)
                except GitError:
                    self.incomplete_at(item.path, item.top)
        for common in sorted(common_dirs):
            if os.path.basename(common) == ".git":
                repos.add(os.path.dirname(common))
            records, errors = worktrees(common)
            repos.update(w["worktree"] for w in records if "worktree" in w)
            for path in errors:
                for top in common_dirs[common]:
                    self.incomplete_at(path, top)
        seen = set()
        for repo in sorted(repos):
            path = os.path.join(repo, ".orchestra", "REGISTRY.md")
            canonical = os.path.realpath(path)
            if canonical in seen:
                continue
            seen.add(canonical)
            try:
                lines = Path(path).read_text().splitlines()
            except FileNotFoundError:
                if os.path.lexists(path):
                    self.incomplete_at(path)
                continue
            except (OSError, UnicodeError):
                self.incomplete_at(path)
                continue
            for number, line in enumerate(lines, 1):
                parts = [part.strip() for part in line.split("|")]
                if len(parts) == 9 and parts[0] == parts[-1] == "" and parts[1].startswith("lead-"):
                    self.rows.append(dict(zip(("slot", "agentId", "task", "branch", "dir",
                                               "status", "updated"), parts[1:-1]), registry=path))
                elif len(parts) > 1 and parts[1].startswith("lead-"):
                    self.bad_rows.append((path, number, line))

    def read_alternates(self):
        common_dirs = set(self.item_common.values())
        if self.reference:
            common_dirs.add(self.reference["common"])
        for common in sorted(common_dirs):
            stack, seen = [(os.path.join(common, "objects"), 0)], {}
            while stack:
                objects, depth = stack.pop()
                if depth >= 5 or seen.get(objects, 5) <= depth:
                    continue
                seen[objects] = depth
                path = os.path.join(objects, "info", "alternates")
                try:
                    lines = Path(path).read_text().splitlines()
                    for line in lines:
                        if not line:
                            continue
                        # Git permits quoted paths; unsupported quoting fails closed.
                        if line.startswith('"'):
                            line = json.loads(line)
                            if not isinstance(line, str):
                                raise ValueError("invalid alternate path")
                        alternate = os.path.realpath(os.path.join(objects, line))
                        self.borrowed_objects.add((alternate, common))
                        stack.append((alternate, depth + 1))
                except FileNotFoundError:
                    if not os.path.lexists(path):
                        continue
                    self.incomplete.append(f"alternates unreadable: {path}")
                except (OSError, UnicodeError, ValueError):
                    self.incomplete.append(f"alternates unreadable: {path}")


def walk_item(item, context):
    base = os.lstat(item.path)
    newest, total, inodes = base.st_mtime, 0, {}
    nested = {i.path for i in context.items if i.root == os.path.join(item.path, ".orchestra", "wt")}
    for mount in context.mounts:
        if under(mount, os.path.realpath(item.path)):
            item.add("DANGER", f"mount point inside: {mount}")
    if context.mounts_incomplete:
        item.add("CAUTION", "mount table unavailable")

    stack = [item.path]
    while stack:
        path = stack.pop()
        rel = os.path.relpath(path, item.path)
        try:
            info = os.lstat(path)
            newest = max(newest, info.st_mtime)
            if info.st_dev != base.st_dev:
                item.add("DANGER", f"mount point inside: {rel}")
                continue
            directory = stat.S_ISDIR(info.st_mode)
            name = os.path.basename(path).lower()
            if not directory and (name == ".env" or name.startswith(".env.") or name == "jev.key"
                                  or name.endswith((".pem", ".key", ".db"))):
                item.add("DANGER", f"secret-shaped file: {rel}")
            if stat.S_ISLNK(info.st_mode) and not under(os.path.realpath(path), os.path.realpath(item.path)):
                item.add("DANGER", f"symlink to outside: {rel} -> {os.readlink(path)}")
            if path in nested:
                item.add("CAUTION", f"contains nested checkout: {rel}")
                continue
            if os.path.basename(path) == ".git" and path != os.path.join(item.path, ".git"):
                item.add("CAUTION", f"contains nested checkout: {os.path.dirname(rel)}")
            if (stat.S_ISREG(info.st_mode) and rel.startswith(".orchestra/")
                    and Path(path).suffix.lower() in context.policy["CHECKPOINT_EXTENSIONS"]):
                item.add("CAUTION", f"checkpoint not kept by git or archive: {rel}")
            if directory:
                total += info.st_blocks * 512
                with os.scandir(path) as entries:
                    stack.extend(reversed([entry.path for entry in entries]))
            else:
                key = info.st_dev, info.st_ino
                record = inodes.setdefault(key, [0, info.st_nlink, info.st_blocks * 512])
                record[0] += 1
        except OSError:
            item.add("CAUTION", f"unreadable: {rel}")
    item.bytes = total + sum(size for seen, links, size in inodes.values() if seen == links)
    item.age_days = max(0, int((time.time() - newest) // 86400))


def inspect_git(item, context):
    path = item.path
    if not os.path.exists(os.path.join(path, ".git")):
        item.add("CAUTION", "not a git checkout")
        return
    if os.path.realpath(git(path, "rev-parse", "--show-toplevel").removesuffix("\n")) != os.path.realpath(path):
        item.add("CAUTION", "not a git checkout root")
        return
    item.kind = "clone" if os.path.isdir(os.path.join(path, ".git")) else "worktree"
    git_dir = git(path, "rev-parse", "--absolute-git-dir").removesuffix("\n")
    item.common_dir = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir").removesuffix("\n")
    partial = partial_clone(path)
    own = ({"top": os.path.dirname(item.common_dir), "common": item.common_dir}
           if item.kind == "worktree" else None)
    references = [own] if own else []
    if context.reference and (not own or os.path.realpath(context.reference["common"])
                              != os.path.realpath(item.common_dir)):
        references.append(context.reference)
    contains_reference = any(under(os.path.realpath(p), os.path.realpath(path))
                             for reference in (own, context.reference) if reference
                             for p in reference.values())
    if partial:
        item.add("CAUTION", f"partial clone: {partial.split()[0]} (objects not read; scan stays offline)")
        if contains_reference:
            item.add("DANGER", "contains the reference repository")
        item.branch = git(path, "symbolic-ref", "-q", "--short", "HEAD", allowed=(0, 1)).strip()
        return
    if item.kind == "clone":
        modules = os.path.join(path, ".git", "modules")
        try:
            names = sorted(os.listdir(modules))
        except FileNotFoundError:
            if os.path.lexists(modules):
                raise
            names = []
        if names:
            item.add("CAUTION", f"submodule repository present: .git/modules/{names[0]}" +
                     (f" +{len(names) - 1} more" if len(names) > 1 else ""))
    elif os.path.realpath(git_dir) == os.path.realpath(item.common_dir):
        item.add("CAUTION", f"separate git dir (main worktree of {item.common_dir})")
    elif os.path.lexists(os.path.join(git_dir, "locked")):
        item.add("CAUTION", "worktree locked")
    filters = git(path, "config", "--get-regexp", r"^filter\.", allowed=(0, 1))
    if filters:
        item.add("CAUTION", f"git filter configured: {filters.split()[0]} (status not run)")
    else:
        records = iter(git(path, "status", "--porcelain=v1", "-z", "--ignored=traditional",
                           "--untracked-files=all", "--ignore-submodules=all").split("\0"))
        dirty, ignored = [], []
        for record in records:
            if not record:
                continue
            flag, name = record[:2], record[3:]
            if flag != "!!":
                dirty.append(name)
                if "R" in flag or "C" in flag:
                    next(records, None)
            elif not name.startswith(".orchestra/") and "__pycache__" not in name.split("/"):
                ignored.append(name)
        if dirty:
            item.add("CAUTION", f"dirty working tree: {len(dirty)} change(s), first {dirty[0]}")
        if ignored:
            item.add("CAUTION", f"git-ignored file would be lost: {ignored[0]}" +
                     (f" +{len(ignored) - 1} more" if len(ignored) > 1 else ""))
        for record in git(path, "ls-files", "-v", "-z").split("\0"):
            if record and (record[0].islower() or record[0] == "S"):
                item.add("CAUTION", f"index flags hide changes: {record[2:]}")
    for directory in {git_dir, item.common_dir}:
        for name in os.listdir(directory):
            if name.endswith(".lock"):
                item.add("CAUTION", f"git lock present: {name}")
    for name in ("rebase-merge", "rebase-apply", "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_LOG"):
        if os.path.lexists(os.path.join(git_dir, name)):
            item.add("CAUTION", f"git operation in progress: {name}")
    head = git(path, "rev-parse", "--verify", "-q", "HEAD^{commit}", allowed=(0, 1)).strip()
    if not head:
        item.add("CAUTION", "no commits")
        return
    item.branch = git(path, "symbolic-ref", "-q", "--short", "HEAD", allowed=(0, 1)).strip()
    reflog_only = git(path, "rev-list", "--reflog", "--not", "--all").splitlines()
    if reflog_only:
        item.add("CAUTION", f"reflog-only commits would be lost: {len(reflog_only)}")
    tips = [(head, "HEAD")]
    refs = git(path, "for-each-ref", "--format=%(objectname) %(objecttype) %(*objectname) %(*objecttype) %(refname)")
    for line in refs.splitlines():
        sha, kind, peeled, peeled_kind, name = line.split(" ")
        if item.kind == "clone":
            if name.startswith("refs/remotes/"):
                continue
        elif not name.startswith(("refs/worktree/", "refs/bisect/", "refs/rewritten/")):
            continue
        if name == "refs/stash":
            item.add("CAUTION", "stash present")
        if kind == "tag":
            sha, kind = peeled, peeled_kind
        if kind != "commit":
            item.add("CAUTION", f"ref {name} is not a commit")
        else:
            tips.append((sha, name))
    for name in sorted(os.listdir(git_dir)):
        if not re.fullmatch(r"[A-Z_]+_HEAD", name) or name in (
                "FETCH_HEAD", "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD"):
            continue
        pseudo_ref = Path(git_dir, name)
        try:
            if not stat.S_ISREG(pseudo_ref.lstat().st_mode):
                continue
            ids = [match[1].lower() for line in pseudo_ref.read_text().splitlines()
                   if (match := re.match(r"([0-9a-fA-F]{64}|[0-9a-fA-F]{40})(?=\s|$)", line))]
        except (OSError, UnicodeError):
            item.add("CAUTION", f"{name} unreadable")
            continue
        if not ids:
            item.add("CAUTION", f"{name} unreadable")
        for sha in ids:
            commit = git(path, "rev-parse", "--verify", "-q", sha + "^{commit}", allowed=(0, 1, 128)).strip()
            if commit != sha:
                item.add("CAUTION", f"{name} is not a commit")
            else:
                tips.append((sha, name))
    if item.kind == "clone":
        records, errors = worktrees(item.common_dir)
        for wt in records:
            item.add("CAUTION", f"has linked worktree registration: {wt['id']}")
        for unreadable in errors:
            item.add("CAUTION", f"worktree registration unreadable: {unreadable}")
    if not references:
        item.add("CAUTION", "no reference repository (use --repo)")
        return
    if contains_reference:
        item.add("DANGER", "contains the reference repository")
    ref = context.options.merged_into
    for reference in references:
        repo = reference["common"]
        if repo not in context.partial:
            context.partial[repo] = partial_clone(repo, common=True)
        if context.partial[repo]:
            item.add("CAUTION", f"reference {repo} is a partial clone; merge state not checked offline")
            continue
        merged = git(repo, "rev-parse", "--verify", "-q", ref + "^{commit}", common=True, allowed=(0, 1)).strip()
        if not merged:
            item.add("CAUTION", f"merged ref {ref} not found in {repo}")
            continue
        for sha, name in tips:
            try:
                git(repo, "cat-file", "-e", sha + "^{commit}", common=True)
            except GitError as error:
                if error.returncode not in (1, 128):
                    raise
                item.add("CAUTION", f"{name} not merged into {ref}")
                continue
            # merge-base has no output; use an explicit return-code result for its predicate.
            try:
                git(repo, "merge-base", "--is-ancestor", sha, merged, common=True)
            except GitError as error:
                if error.returncode != 1:
                    raise
                item.add("CAUTION", f"{name} not merged into {ref}")


def activity(item, context, real_path):
    for path, pid, comm in context.processes:
        if under(path, real_path):
            item.add("DANGER", f"in use by pid {pid} ({comm})")
    for message in context.proc_incomplete:
        item.add("CAUTION", message)
    for message in context.incomplete + context.incomplete_by_top.get(item.top, []):
        item.add("CAUTION", message)
    for path, source, _ in context.sessions:
        if under(path, item.path) or under(os.path.realpath(path), real_path):
            item.add("CAUTION", f"session record {source}")


def registry(item, context, real_path):
    matches = []
    for path, number, raw in context.bad_rows:
        branch_match = item.branch and re.search(r"(?:^|[\s|])" + re.escape(item.branch) + r"(?=$|[\s|])", raw)
        if branch_match or os.path.basename(item.path) + "/" in raw or item.path in raw:
            item.add("CAUTION", f"unparseable registry row mentions this item: {path}:{number}")
    for row in context.rows:
        checkout = os.path.dirname(os.path.dirname(row["registry"]))
        paths = ([row["dir"]] if os.path.isabs(row["dir"]) else
                 [os.path.join(checkout, row["dir"]), os.path.join(os.path.dirname(checkout), row["dir"])])
        if not ((item.branch and row["branch"] == item.branch) or
                (row["dir"] and any(under(os.path.normpath(p), base)
                                    for p in paths for base in (item.path, real_path)))):
            continue
        status = row["status"]
        matches.append(status)
        if not status:
            item.add("CAUTION", "registry status empty")
        elif not TERMINAL.match(status):
            item.add("DANGER", f"open registry row: {status} ({row['registry']})")
        elif not COMPLETE.match(status):
            item.add("CAUTION", f"registry status {status}: inactivity is not deletion authorization")
    if not matches:
        item.add("CAUTION", "no registry row")
    return matches


def archive(item, context):
    tasks = []
    path = os.path.join(item.path, ".orchestra")
    try:
        with os.scandir(path) as entries:
            for entry in entries:
                if entry.name != "wt" and entry.is_dir(follow_symlinks=False) and (
                        re.match(r"^\d+[-_]", entry.name) or any(os.path.isfile(os.path.join(entry.path, n))
                                                              for n in ("brief.md", "plan.md", "summary.md"))):
                    tasks.append(entry.name)
    except FileNotFoundError:
        pass
    except OSError:
        item.add("CAUTION", "unreadable: .orchestra")
    count = sum(orch_archive.slug(item.id.split("/", 1)[0]) + "--" +
                re.sub(r"[\\/\[\]|#\x00-\x1f]", "-", task) + ".md" in context.notes for task in tasks)
    item.archive = "-" if not tasks else "yes" if count == len(tasks) else f"{count}/{len(tasks)}" if count else "no"


def classify(item, context):
    if os.path.islink(item.path):
        item.add("DANGER", f"symlink escapes root: {item.path} -> {os.readlink(item.path)}")
        return item
    if not contained(item.path, item):
        item.add("DANGER", f"path escapes root: {os.path.realpath(item.path)}")
        return item
    real_path = os.path.realpath(item.path)
    try:
        walk_item(item, context)
    except OSError:
        item.add("CAUTION", "unreadable: .")
    for objects, common in sorted(context.borrowed_objects):
        own_repo = (os.path.isdir(os.path.join(item.path, ".git"))
                    and common == context.item_common.get(item.path))
        if not own_repo and under(objects, real_path):
            item.add("DANGER", f"objects borrowed by {common}")
    archive(item, context)
    if item.backup:
        item.add("CAUTION", "temp backup (report-only)")
        activity(item, context, real_path)
        return item
    try:
        inspect_git(item, context)
    except (GitError, OSError, ValueError) as error:
        item.add("CAUTION", f"git unreadable: {error}")
    activity(item, context, real_path)
    statuses = registry(item, context, real_path)
    if item.classification == "SAFE":
        item.add("SAFE", f"merged into {context.options.merged_into}; clean; registry {statuses[0]}")
    return item


def scan(options):
    context = Context(options)
    for item in context.items:
        classify(item, context)
    return context


def human(size):
    value = float(size)
    for unit in "BKMG":
        if value < 1024 or unit == "G":
            return f"{value:.1f}{unit}"
        value /= 1024


def table_field(value):
    text = "".join(" " if unicodedata.category(char) in ("Cc", "Zl", "Zp") else
                   f"\\x{ord(char) - 0xdc00:02x}" if 0xdc80 <= ord(char) <= 0xdcff else char
                   for char in str(value))
    encoding = getattr(sys.stdout, "encoding", None) or "utf-8"
    return text.encode(encoding, "backslashreplace").decode(encoding)


def print_line(text):
    print(table_field(text))


def report(context, as_json):
    totals = {key: {"count": 0, "bytes": 0} for key in ("SAFE", "CAUTION", "DANGER", "all")}
    for item in context.items:
        for key in (item.classification, "all"):
            totals[key]["count"] += 1
            totals[key]["bytes"] += item.bytes
    if as_json:
        print(json.dumps(dict(merged_into=context.options.merged_into,
                              reference=context.reference["top"] if context.reference else None,
                              items=[i.record() for i in context.items], totals=totals)))
        return
    print("CLASS  SIZE  AGE  ARCHIVE  ID  REASON")
    for item in context.items:
        print("  ".join(table_field(value) for value in (item.classification, human(item.bytes),
                       f"{item.age_days}d", item.archive, item.id, item.reason())))
    print_line("totals: " + " · ".join(f"{key} {v['count']} ({v['bytes']} bytes)" for key, v in totals.items()))
    print_line("note: deletion is disabled in this release; apply refuses and nothing is deleted - SAFE marks checkouts that could be removed manually after review")
    print_line("note: archive=yes means orch-archive holds a vault note per task directory; the archive is not a full copy (checkpoints, original images and oversized payloads are not stored), and deleting a checkout also deletes its git-ignored .orchestra/ artifacts")
    print_line("note: orch-gc never deletes anything in this release")


def apply():
    print("orch-gc: apply is disabled in this release; nothing was deleted.", file=sys.stderr)
    print('orch-gc: deletion stays off until open review findings are fixed (--repo vs worktree items, "(deleted)" path names, "~N" id collisions, partial-clone fetch); a follow-up task re-enables it. Clean up manually after reading \'orch-gc scan\'.', file=sys.stderr)
    return 1


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    commands = result.add_subparsers(dest="command", required=True)
    for command in ("scan", "apply"):
        sub = commands.add_parser(command, add_help=command == "scan")
        if command == "apply":
            sub.add_argument("args", nargs=argparse.REMAINDER)
            continue
        sub.add_argument("--root", action="append", default=[])
        sub.add_argument("--merged-into", default="local/installed-main")
        sub.add_argument("--repo")
        sub.add_argument("--json", action="store_true")
    return result


def main(argv):
    if not argv or argv[0] not in ("scan", "apply", "-h", "--help"):
        argv = ["scan", *argv]
    cli = parser()
    # Treat even unknown flags and --help as positional arguments to the disabled command.
    options = cli.parse_args(["apply", "--", *argv[1:]] if argv[0] == "apply" else argv)
    if options.command == "apply":
        return apply()
    try:
        context = scan(options)
        report(context, options.json)
        return 0
    except (OSError, ValueError, orch_archive.ArchiveError) as error:
        print(table_field(f"error: {error}"), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
